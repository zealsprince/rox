# Build-time service identities. Copy this to .env and fill in what you have;
# crates/rox/build.rs bakes them into the binary at compile time. Every one is
# optional and a build without them works the same minus that integration.
# Exported environment variables win over anything set here, which is how the
# release workflow passes the repository secrets of the same names.

# A last.fm api account (last.fm/api/account/create). Turns on one-click
# scrobbler connect; without it the settings page asks for your own pair.
LASTFM_API_KEY=
LASTFM_API_SECRET=

# A Discord application (discord.com/developers). Turns on rich presence.
# Public by design, Discord shows it on the application page.
DISCORD_CLIENT_ID=
