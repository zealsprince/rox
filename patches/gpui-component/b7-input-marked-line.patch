+    /// rox patch: mark a row (0-based, unwrapped) to paint with `color`
+    /// behind its text, independent of where the cursor is. Upstream only
+    /// paints the cursor's row, and only in code editor mode; rox's lyrics
+    /// editor lights the line under the playhead while the sheet is being
+    /// edited, which is a different row from the one being typed on.
+    /// `None` clears the mark. Repaints when the row changes; a color
+    /// change alone waits for the next frame something else asks for.
+    pub fn set_marked_line(&mut self, marked: Option<(usize, Hsla)>, cx: &mut Context<Self>) {
+        let moved = self.marked_line.map(|(row, _)| row) != marked.map(|(row, _)| row);
+        self.marked_line = marked;
+        if moved {
+            cx.notify();
+        }
+    }
