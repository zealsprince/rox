+    /// rox patch: a single-line input never holds a line break, typed, pasted
+    /// or set. gpui shapes its text as one line and asserts there's none, and
+    /// an Enter nothing handles arrives here as typed text.
+    fn single_line_text<'a>(&self, text: &'a str) -> std::borrow::Cow<'a, str> {
+        if self.mode.is_single_line() && text.contains(['\n', '\r']) {
+            std::borrow::Cow::Owned(text.replace(['\n', '\r'], ""))
+        } else {
+            std::borrow::Cow::Borrowed(text)
+        }
+    }
