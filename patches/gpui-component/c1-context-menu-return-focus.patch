+/// rox patch: an outside press closes the menu without a dismiss when a
+/// submenu is open, so focus goes back here too.
+fn close_menu(state: &Rc<RefCell<ContextMenuSharedState>>, window: &mut Window, cx: &mut App) {
+    let menu = {
+        let mut state = state.borrow_mut();
+        state.open = false;
+        state.menu_view.clone()
+    };
+
+    if let Some(menu) = menu {
+        menu.read(cx).return_focus(window, cx);
+    }
+    window.refresh();
+}
