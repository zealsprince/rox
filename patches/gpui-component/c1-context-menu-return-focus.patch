+    /// rox patch: focus goes back to the action context only while this menu
+    /// or one of its submenus still holds it. Upstream refocused it always,
+    /// which takes focus back off whatever a picked item just focused.
+    pub(crate) fn return_focus(&self, window: &mut Window, cx: &App) {
+        let Some(action_context) = self.action_context.as_ref() else {
+            return;
+        };
+
+        if self.focus_handle.contains_focused(window, cx) || window.focused(cx).is_none() {
+            window.focus(action_context);
+        }
+    }
