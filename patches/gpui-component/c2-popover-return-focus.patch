+    /// rox patch: a Button trigger keeps its press from moving focus, so
+    /// what had focus before the press stands. Any other trigger lets the
+    /// press go on to focus the panel or dialog it sits in, after
+    /// toggle_open took focus, and that's where focus belongs on close. The
+    /// popover takes focus back from it, as toggle_open meant to.
+    fn settle_focus(&mut self, window: &mut Window, cx: &App) {
+        if !std::mem::take(&mut self.settling) {
+            return;
+        }
+
+        let own = self
+            .tracked_focus_handle
+            .clone()
+            .unwrap_or_else(|| self.focus_handle.clone());
+        if own.is_focused(window) {
+            return;
+        }
+
+        if let Some(moved) = window.focused(cx) {
+            self.focus_before_open = Some(moved);
+        }
+        own.focus(window);
+    }
+
+    /// rox patch: without this the closed popover kept focus, and the panel
+    /// or dialog it opened over went deaf until clicked. Only while focus is
+    /// still inside the popover: a picked item may have moved it on purpose.
+    fn return_focus(&mut self, window: &mut Window, cx: &App) {
+        let Some(before) = self.focus_before_open.take() else {
+            return;
+        };
+
+        let inside = self.focus_handle.contains_focused(window, cx)
+            || self
+                .tracked_focus_handle
+                .as_ref()
+                .is_some_and(|handle| handle.contains_focused(window, cx));
+        if inside || window.focused(cx).is_none() {
+            window.focus(&before);
+        }
+    }
