+    /// rox patch: Escape closes the menu with a submenu open too. dismiss()
+    /// skips that case so a press in the submenu, which lands outside this
+    /// menu, can't close it before the item takes the click.
+    fn cancel(&mut self, _: &Cancel, window: &mut Window, cx: &mut Context<Self>) {
+        self.selected_index = None;
+        self.dismiss(&Cancel, window, cx);
+    }
+
+    /// rox patch: whether a press lands in a submenu this menu has open, at
+    /// any depth.
+    fn in_open_submenu(&self, position: gpui::Point<Pixels>, cx: &App) -> bool {
+        self.active_submenu().is_some_and(|submenu| {
+            let submenu = submenu.read(cx);
+            submenu.bounds.contains(&position) || submenu.in_open_submenu(position, cx)
+        })
+    }
+
