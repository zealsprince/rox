+// What one binding of a chain pass carries at draw time. Blade matches the
+// bind group against the module's globals, and a pass only declares what its
+// source named, so the group is built per pass rather than derived.
+enum ChainBindValue {
+    Params(ShaderParams),
+    Texture(gpu::TextureView),
+    Sampler(gpu::Sampler),
+}
+
+// The hand-rolled counterpart to `blade_macros::ShaderData`. `bind` fills
+// against the layout the pipeline was built with and never asks the type for
+// one, so the values here only have to arrive in the order that layout lists.
+struct ChainShaderData<'a> {
+    values: &'a [ChainBindValue],
+}
+
+impl gpu::ShaderData for ChainShaderData<'_> {
+    fn layout() -> gpu::ShaderDataLayout {
+        // Never reached: chain pipelines are built from the layout stored on
+        // the pass, which is the thing `bind` fills against.
+        gpu::ShaderDataLayout::default()
+    }
+
+    fn fill(&self, mut context: gpu::PipelineContext) {
+        use gpu::ShaderBindable as _;
+
+        for (index, value) in self.values.iter().enumerate() {
+            let index = index as u32;
+            match value {
+                ChainBindValue::Params(params) => params.bind_to(&mut context, index),
+                ChainBindValue::Texture(view) => view.bind_to(&mut context, index),
+                ChainBindValue::Sampler(sampler) => sampler.bind_to(&mut context, index),
+            }
+        }
+    }
 }
 
