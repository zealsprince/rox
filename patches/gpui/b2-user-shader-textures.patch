+/// rox patch: the one-pass shape a plain source registers as. Named `main`,
+/// full size, no assets, which is what every shader that predates chains is.
+fn one_pass_chain(source: &str) -> UserShaderChain {
+    UserShaderChain {
+        passes: vec![UserShaderPass {
+            name: "main".to_string(),
+            source: source.to_string(),
+            scale: 1.0,
+        }],
+        assets: Vec::new(),
+    }
+}
+
+/// rox patch: this window's caller-provided images, keyed by their pixel bytes
+/// so the same image registered twice uploads once.
+#[derive(Default)]
+pub(crate) struct UserTextureRegistry {
+    by_hash: std::collections::HashMap<u64, UserTextureId>,
+    count: u32,
+}
+
+impl UserTextureRegistry {
+    /// Registers an rgba8 image, returning its id and whether this call is
+    /// what created it.
+    #[cfg_attr(
+        not(any(target_os = "linux", target_os = "freebsd")),
+        allow(dead_code)
+    )]
+    fn register(
+        &mut self,
+        width: u32,
+        height: u32,
+        rgba8: &[u8],
+    ) -> std::result::Result<(UserTextureId, bool), String> {
+        use std::hash::{Hash as _, Hasher as _};
+
+        if width == 0 || height == 0 {
+            return Err("a user texture needs a non-zero width and height".to_string());
+        }
+        let expected = width as usize * height as usize * 4;
+        if rgba8.len() != expected {
+            return Err(format!(
+                "a {width}x{height} rgba8 image is {expected} bytes, got {}",
+                rgba8.len()
+            ));
+        }
+
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        width.hash(&mut hasher);
+        height.hash(&mut hasher);
+        rgba8.hash(&mut hasher);
+        let hash = hasher.finish();
+        if let Some(id) = self.by_hash.get(&hash) {
+            return Ok((*id, false));
+        }
+
+        let id = UserTextureId(self.count);
+        self.count += 1;
+        self.by_hash.insert(hash, id);
+        Ok((id, true))
+    }
+}
