+// Blade wants `&'static str` binding names and a chain's pass and asset names
+// come out of user text, so they leak once and every later chain that uses the
+// same name reuses the leak. Bounded by the registry's keep-forever policy: a
+// name only ever gets here from a chain that already registered.
+fn intern_binding_name(name: &str) -> &'static str {
+    use std::sync::{Mutex, OnceLock};
+
+    static NAMES: OnceLock<Mutex<std::collections::HashSet<&'static str>>> = OnceLock::new();
+    let mut names = NAMES
+        .get_or_init(|| Mutex::new(std::collections::HashSet::new()))
+        .lock()
+        .unwrap();
+    if let Some(interned) = names.get(name) {
+        return interned;
+    }
+    let interned: &'static str = Box::leak(name.to_string().into_boxed_str());
+    names.insert(interned);
+    interned
+}
+
+// The bind group layout for one pass, in the same pinned order the composed
+// module declares its globals in.
+fn chain_pass_layout(bindings: &[ChainBinding]) -> gpu::ShaderDataLayout {
+    gpu::ShaderDataLayout {
+        bindings: bindings
+            .iter()
+            .map(|binding| {
+                let kind = match binding {
+                    ChainBinding::Params => gpu::ShaderBinding::Plain {
+                        size: std::mem::size_of::<ShaderParams>() as u32,
+                    },
+                    ChainBinding::Sampler => gpu::ShaderBinding::Sampler,
+                    _ => gpu::ShaderBinding::Texture,
+                };
+                (intern_binding_name(binding.name()), kind)
+            })
+            .collect(),
+    }
 }
 
