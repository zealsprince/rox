@@ -580,6 +583,15 @@
 version = "25.0"
 features = ["wgsl-in"]
 
+# rox patch: the macos-blade shader path needs naga at runtime the same way the
+# blade backends do, and a manifest cfg() can't test a feature. Same two-table
+# shape blade-graphics already uses above: plain optional here, named by the
+# macos-blade feature, target-gated for linux and freebsd.
+[dependencies.naga]
+version = "25.0"
+features = ["wgsl-in"]
+optional = true
+
 [target.'cfg(any(target_os = "linux", target_os = "freebsd"))'.build-dependencies.naga]
