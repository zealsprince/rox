+    // rox patch: gpui 0.2.2 has no Windows implementation, so the app's
+    // hide-decorations toggle never reached the caption. Flip the live
+    // hide_title_bar flag and re-run WM_NCCALCSIZE via SWP_FRAMECHANGED so the
+    // OS caption is stripped (Client) or restored (Server) in place, without
+    // reopening the window.
+    fn request_decorations(&self, decorations: WindowDecorations) {
+        let hide = matches!(decorations, WindowDecorations::Client);
+        if self.0.hide_title_bar.get() == hide {
+            return;
+        }
+        self.0.hide_title_bar.set(hide);
+        let hwnd = self.0.hwnd;
+        // Deferred to the executor, the way gpui's own toggle_fullscreen is:
+        // request_decorations runs inside a window update, and the frame change
+        // forces a WM_SIZE that Windows dispatches synchronously, whose resize
+        // callback re-enters that update and panics. On its own tick it settles
+        // safely. Re-passing the current outer size without SWP_NOSIZE is what
+        // makes Windows emit that WM_SIZE: the caption came or went, so the
+        // client area changed, and without the resize the reclaimed strip is
+        // left as a transparent gap until the next real resize.
+        self.0
+            .executor
+            .spawn(async move {
+                let mut rect = RECT::default();
+                unsafe {
+                    GetWindowRect(hwnd, &mut rect).log_err();
+                    SetWindowPos(
+                        hwnd,
+                        None,
+                        0,
+                        0,
+                        rect.right - rect.left,
+                        rect.bottom - rect.top,
+                        SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE,
+                    )
+                    .log_err();
+                }
+            })
+            .detach();
+    }
+
+    fn start_window_move(&self) {
+        // gpui leaves this a no-op on Windows, so the app's drag grips never
+        // moved the window. Deferred to the executor: this runs inside the
+        // mouse-down update, and the OS move loop pumps WM_MOVE whose moved
+        // callback re-enters that update. On its own tick the drag runs clear.
+        // ReleaseCapture hands off gpui's click capture; WM_NCLBUTTONDOWN with
+        // HTCAPTION starts the OS move as if the title bar were grabbed, and it
+        // follows the mouse until the button lifts.
+        let hwnd = self.0.hwnd;
+        self.0
+            .executor
+            .spawn(async move {
+                unsafe {
+                    ReleaseCapture().log_err();
+                    SendMessageW(
+                        hwnd,
+                        WM_NCLBUTTONDOWN,
+                        Some(WPARAM(HTCAPTION as usize)),
+                        None,
+                    );
+                }
+            })
+            .detach();
+    }
+
+    fn window_decorations(&self) -> Decorations {
+        if self.0.hide_title_bar.get() {
+            Decorations::Client {
+                tiling: Tiling::default(),
+            }
+        } else {
+            Decorations::Server
+        }
+    }
