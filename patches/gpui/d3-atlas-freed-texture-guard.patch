+    /// rox patch: None for a texture that's already been freed. A sprite
+    /// painted before an image was dropped can still name one, from a cached
+    /// view that hasn't repainted since. The renderer skips that batch for the
+    /// frame instead of panicking on it, and the first miss per texture logs
+    /// so the early drop can be traced.
+    pub fn get_texture_info(&self, id: AtlasTextureId) -> Option<BladeTextureInfo> {
+        let mut lock = self.0.lock();
+        let raw_view = lock.storage.get(id).map(|texture| texture.raw_view);
+        if raw_view.is_none() && lock.missing.insert(id) {
+            log::warn!("blade atlas: a sprite named freed texture {id:?}, skipped until it repaints");
         }
+
+        raw_view.map(|raw_view| BladeTextureInfo { raw_view })
     }
