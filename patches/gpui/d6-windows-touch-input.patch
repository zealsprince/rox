+/// rox patch: the contact's positions since the last message, oldest first.
+/// Windows coalesces the moves between messages, and a fling measured from the
+/// newest point alone comes out too slow or not at all.
+fn touch_samples(
+    handle: HWND,
+    pointer_id: u32,
+    msg: u32,
+    scale_factor: f32,
+) -> Vec<(Instant, Point<Pixels>)> {
+    let mut info = POINTER_INFO::default();
+    if unsafe { GetPointerInfo(pointer_id, &mut info) }
+        .log_err()
+        .is_none()
+    {
+        return Vec::new();
+    }
+
+    let mut history = vec![info];
+    if msg == WM_POINTERUPDATE && info.historyCount > 1 {
+        let mut count = info.historyCount;
+        let mut entries = vec![POINTER_INFO::default(); count as usize];
+        if unsafe { GetPointerInfoHistory(pointer_id, &mut count, Some(entries.as_mut_ptr())) }
+            .is_ok()
+        {
+            entries.truncate(count as usize);
+            history = entries;
+        }
+    }
+
+    let now = Instant::now();
+    let mut counter = 0i64;
+    let mut frequency = 0i64;
+    let clock = unsafe {
+        QueryPerformanceCounter(&mut counter).is_ok()
+            && QueryPerformanceFrequency(&mut frequency).is_ok()
+    };
+
+    // The history lists the newest entry first.
+    history
+        .iter()
+        .rev()
+        .map(|entry| {
+            // The raw location skips Windows' prediction, which jitters a pan.
+            let mut position = entry.ptPixelLocationRaw;
+            unsafe { ScreenToClient(handle, &mut position).ok().log_err() };
+
+            let stamp = entry.PerformanceCount as i64;
+            let at = if clock && frequency > 0 && stamp > 0 && stamp <= counter {
+                let age = (counter - stamp) as f64 / frequency as f64;
+                now.checked_sub(Duration::from_secs_f64(age)).unwrap_or(now)
+            } else {
+                now
+            };
+
+            (
+                at,
+                logical_point(position.x as f32, position.y as f32, scale_factor),
+            )
+        })
+        .collect()
+}
