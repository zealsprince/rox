+    // rox patch: a caption press the app lets through goes to DefWindowProc,
+    // whose move loop waits for the pointer to move before it pumps anything:
+    // about half a second for a click that never moves, the whole hold for a
+    // press held still. Nothing of ours runs meanwhile (no WM_PAINT, no
+    // WM_TIMER, no posted tasks), so every animation stops dead. A posted
+    // WM_MOUSEMOVE wakes the loop at once, the loop swallows it, and from
+    // there WM_ENTERSIZEMOVE's timer keeps frames coming. lparam has to be 0:
+    // the press's own coordinates don't wake it. Same workaround winit ships
+    // (winit #839, regressed by #1852, restored in #4136). Covers
+    // start_window_move too, which sends its press through here.
+    fn handle_caption_press(&self, handle: HWND, wparam: WPARAM, lparam: LPARAM) -> Option<isize> {
+        if wparam.0 != HTCAPTION as usize {
+            return None;
+        }
+        unsafe {
+            PostMessageW(Some(handle), WM_MOUSEMOVE, WPARAM(0), LPARAM(0)).log_err();
+            let result = DefWindowProcW(handle, WM_NCLBUTTONDOWN, wparam, lparam);
+            // If the move was refused and no loop ran, the nudge is still
+            // queued and would reach handle_mouse_move_msg as a jump to the
+            // top-left corner. Posted messages only, so a real move waiting in
+            // the input queue stays put.
+            let mut msg = MSG::default();
+            let _ = PeekMessageW(
+                &mut msg,
+                Some(handle),
+                WM_MOUSEMOVE,
+                WM_MOUSEMOVE,
+                PM_REMOVE | PM_QS_POSTMESSAGE,
+            );
+            Some(result.0)
+        }
+    }
