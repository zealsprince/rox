+    /// Paint a caller-owned texture stretched over an arbitrary convex quad
+    /// with perspective-correct sampling. Everything but the texture works
+    /// the way it does in [`Window::paint_image_quad`]: `corners` clockwise
+    /// from the top-left, `source` the 0..1 fraction of the texture to sample
+    /// (a negative size samples backwards), `fade` the alpha at each corner
+    /// and `wash` a straight-alpha color mixed over the sample.
+    ///
+    /// `texture` comes from [`Window::register_user_texture`] or
+    /// [`Window::register_dynamic_texture`]. An id the renderer no longer
+    /// holds paints nothing, including a dynamic one released in the same
+    /// frame. Backends without user textures return `Err("unsupported")`.
+    ///
+    /// This method should only be called as part of the paint phase of element drawing.
+    ///
+    /// rox patch: the perspective face of the polychrome pipeline, sampling a
+    /// caller-owned texture where `paint_image_quad` samples the atlas.
+    pub fn paint_texture_quad(
+        &mut self,
+        corners: [Point<Pixels>; 4],
+        source: Bounds<f32>,
+        texture: UserTextureId,
+        fade: [f32; 4],
+        wash: Hsla,
+    ) -> Result<()> {
+        self.invalidator.debug_assert_paint();
+
+        #[cfg(any(
+            target_os = "linux",
+            target_os = "freebsd",
+            all(target_os = "macos", feature = "macos-blade"),
+            target_os = "windows"
+        ))]
+        {
+            use crate::TextureSprite;
+
+            if !self.platform_window.user_shaders_supported() {
+                return Err(anyhow!("unsupported"));
+            }
+            // The shader holds the sample inside the crop's texel centers, and
+            // an empty crop has no inside to hold it to.
+            if source.size.width == 0. || source.size.height == 0. {
+                return Ok(());
+            }
+
+            let scale_factor = self.scale_factor();
+            let Some((bounds, transformation, perspective)) = quad_face(corners, scale_factor)
+            else {
+                return Ok(());
+            };
+            let content_mask = self.content_mask().scale(scale_factor);
+            let opacity = self.element_opacity();
+
+            self.next_frame.scene.insert_primitive(TextureSprite {
+                order: 0,
+                texture_id: texture.0,
+                opacity,
+                pad: 0,
+                bounds,
+                content_mask,
+                source,
+                transformation,
+                pad2: [0.; 2],
+                perspective,
+                fade,
+                wash: {
+                    let wash = crate::Rgba::from(wash);
+                    [wash.r, wash.g, wash.b, wash.a]
+                },
+            });
+            Ok(())
+        }
+        #[cfg(not(any(
+            target_os = "linux",
+            target_os = "freebsd",
+            all(target_os = "macos", feature = "macos-blade"),
+            target_os = "windows"
+        )))]
+        {
+            let _ = (corners, source, texture, fade, wash);
+            Err(anyhow!("unsupported"))
+        }
+    }
