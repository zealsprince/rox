+/// The face a primitive painted over `corners` (window pixels, clockwise from
+/// the top-left) needs, in scaled pixels: the corners' bounding box, which is
+/// the primitive's bounds and so what its paint order is decided on, and the
+/// [`quad_homography`] carrying that box onto the corners. None when the quad
+/// is degenerate or leans past its own horizon.
+///
+/// rox patch: the CPU half of `paint_texture_quad`, the same steps
+/// `paint_image_quad` takes inline.
+#[cfg_attr(
+    not(any(
+        target_os = "linux",
+        target_os = "freebsd",
+        all(target_os = "macos", feature = "macos-blade"),
+        target_os = "windows"
+    )),
+    allow(dead_code)
+)]
+fn quad_face(
+    corners: [Point<Pixels>; 4],
+    scale_factor: f32,
+) -> Option<(Bounds<ScaledPixels>, TransformationMatrix, [f32; 4])> {
+    let quad = corners.map(|corner| {
+        let corner = corner.scale(scale_factor);
+        [corner.x.0, corner.y.0]
+    });
+    let (mut min_x, mut min_y) = (quad[0][0], quad[0][1]);
+    let (mut max_x, mut max_y) = (min_x, min_y);
+    for [x, y] in &quad {
+        min_x = min_x.min(*x);
+        min_y = min_y.min(*y);
+        max_x = max_x.max(*x);
+        max_y = max_y.max(*y);
+    }
+
+    let bounds = Bounds {
+        origin: point(ScaledPixels(min_x), ScaledPixels(min_y)),
+        size: size(ScaledPixels(max_x - min_x), ScaledPixels(max_y - min_y)),
+    };
+    let (transformation, perspective) =
+        quad_homography([min_x, min_y], [max_x - min_x, max_y - min_y], quad)?;
+    Some((bounds, transformation, perspective))
+}
+
+#[cfg(test)]
+mod quad_face_tests {
+    use super::*;
+
+    fn corners(points: [[f32; 2]; 4]) -> [Point<Pixels>; 4] {
+        points.map(|[x, y]| point(px(x), px(y)))
+    }
+
+    // Where the homography puts a point of the box, divide included.
+    fn project(
+        transformation: &TransformationMatrix,
+        perspective: &[f32; 4],
+        [x, y]: [f32; 2],
+    ) -> [f32; 2] {
+        let [row0, row1] = transformation.rotation_scale;
+        let [tx, ty] = transformation.translation;
+        let w = perspective[2] + perspective[0] * x + perspective[1] * y;
+        [
+            (row0[0] * x + row0[1] * y + tx) / w,
+            (row1[0] * x + row1[1] * y + ty) / w,
+        ]
+    }
+
+    #[test]
+    fn the_bounds_are_the_scaled_corners_bounding_box() {
+        // A keystone: the right edge is shorter than the left.
+        let quad = [[10., 20.], [110., 40.], [110., 80.], [10., 100.]];
+        let (bounds, transformation, perspective) = quad_face(corners(quad), 2.).unwrap();
+
+        assert_eq!(bounds.origin, point(ScaledPixels(20.), ScaledPixels(40.)));
+        assert_eq!(bounds.size, size(ScaledPixels(200.), ScaledPixels(160.)));
+
+        // The box's corners land on the scaled quad's.
+        let (x0, y0) = (bounds.origin.x.0, bounds.origin.y.0);
+        let (x1, y1) = (x0 + bounds.size.width.0, y0 + bounds.size.height.0);
+        for (from, [x, y]) in [[x0, y0], [x1, y0], [x1, y1], [x0, y1]]
+            .into_iter()
+            .zip(quad)
+        {
+            let [sx, sy] = project(&transformation, &perspective, from);
+            assert!((sx - x * 2.).abs() < 1e-2, "{sx} vs {}", x * 2.);
+            assert!((sy - y * 2.).abs() < 1e-2, "{sy} vs {}", y * 2.);
+        }
+    }
+
+    #[test]
+    fn a_crossed_or_flat_quad_has_no_face() {
+        // Crossed edges: the top-right and bottom-right corners swapped.
+        let bowtie = [[0., 0.], [100., 100.], [100., 0.], [0., 100.]];
+        assert!(quad_face(corners(bowtie), 1.).is_none());
+
+        let line = [[0., 0.], [100., 0.], [100., 0.], [0., 0.]];
+        assert!(quad_face(corners(line), 1.).is_none());
+    }
+}
