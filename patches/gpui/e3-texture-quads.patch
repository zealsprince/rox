+/// rox patch: a caller-owned texture on a perspective face, painted by
+/// `Window::paint_texture_quad`. The polychrome sprite's face without the
+/// atlas: the texture is a `UserTextureId`, so it batches on that instead of
+/// an atlas texture, and the crop is a 0..1 `source` rather than a tile.
+/// Layout matches the `TextureSprite` struct in both shader files, padding
+/// included.
+#[derive(Clone, Debug)]
+#[repr(C)]
+pub(crate) struct TextureSprite {
+    pub order: DrawOrder,
+    pub texture_id: u32,
+    pub opacity: f32,
+    pub pad: u32,
+    pub bounds: Bounds<ScaledPixels>,
+    pub content_mask: ContentMask<ScaledPixels>,
+    pub source: Bounds<f32>,
+    pub transformation: TransformationMatrix,
+    pub pad2: [f32; 2],
+    // The homography's perspective row, as on `PolychromeSprite`.
+    pub perspective: [f32; 4],
+    pub fade: [f32; 4],
+    pub wash: [f32; 4],
+}
+
+impl From<TextureSprite> for Primitive {
+    fn from(sprite: TextureSprite) -> Self {
+        Primitive::TextureSprite(sprite)
+    }
+}
