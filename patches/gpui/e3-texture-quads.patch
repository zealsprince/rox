+/*
+**
+**              Texture sprites
+**
+*/
+
+// rox patch: paint_texture_quad, the polychrome sprite's perspective face
+// sampling a user texture instead of an atlas tile. `source` is the 0..1
+// crop, and a negative size samples backwards.
+struct TextureSprite {
+    uint order;
+    uint texture_id;
+    float opacity;
+    uint pad;
+    Bounds bounds;
+    Bounds content_mask;
+    Bounds source;
+    TransformationMatrix transformation;
+    float2 pad2;
+    float4 perspective;
+    float4 fade;
+    float4 wash;
+};
+
+StructuredBuffer<TextureSprite> tex_sprites: register(t1);
+
+// The exact sRGB encode. `linear_to_srgb` above is a 2.2 power curve that
+// runs the other way.
+float3 encode_srgb(float3 linear_rgb) {
+    float3 higher = 1.055 * pow(linear_rgb, 1.0 / 2.4) - 0.055;
+    float3 lower = linear_rgb * 12.92;
+    return lerp(higher, lower, step(linear_rgb, 0.0031308));
+}
+
+PolychromeSpriteVertexOutput texture_sprite_vertex(uint vertex_id: SV_VertexID, uint sprite_id: SV_InstanceID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    TextureSprite sprite = tex_sprites[sprite_id];
+    float2 local_position = unit_vertex * sprite.bounds.size + sprite.bounds.origin;
+    // Same projection as polychrome_sprite_vertex.
+    float2 transformed =
+        mul(local_position, sprite.transformation.rotation_scale) + sprite.transformation.translation;
+    float w = sprite.perspective.z + dot(sprite.perspective.xy, local_position);
+    float2 dp = transformed / global_viewport_size * float2(2.0, -2.0);
+    float4 device_position = float4(dp + float2(-1.0, 1.0) * w, 0.0, w);
+    float2 projected = transformed / w;
+
+    PolychromeSpriteVertexOutput output;
+    output.position = device_position;
+    output.tile_position = sprite.source.origin + unit_vertex * sprite.source.size;
+    output.sprite_id = sprite_id;
+    output.local_position = local_position;
+    output.clip_distance = distance_from_clip_rect_impl(projected, sprite.content_mask) * w;
+    return output;
+}
+
+float4 texture_sprite_fragment(PolychromeSpriteFragmentInput input): SV_Target {
+    TextureSprite sprite = tex_sprites[input.sprite_id];
+    // Held to the crop's texel centers like an atlas tile, so the edge
+    // fragments don't filter in texels outside it. Sorted first for a
+    // backwards crop.
+    float2 texture_size;
+    t_sprite.GetDimensions(texture_size.x, texture_size.y);
+    float2 half_texel = 0.5 / texture_size;
+    float2 edge_a = sprite.source.origin;
+    float2 edge_b = sprite.source.origin + sprite.source.size;
+    float2 uv = clamp(input.tile_position, min(edge_a, edge_b) + half_texel,
+                      max(edge_a, edge_b) - half_texel);
+    float4 sample = t_sprite.Sample(s_sprite, uv);
+    Corners square = (Corners)0;
+    float distance = quad_sdf(input.local_position, sprite.bounds, square);
+
+    // User textures are R8G8B8A8_UNORM_SRGB, so the sample arrives linear.
+    // The atlas and the render target are plain UNORM holding sRGB-encoded
+    // values, which is what the blend and the wash expect, so encode it
+    // back. Alpha is straight in both.
+    float4 color = float4(encode_srgb(sample.rgb), sample.a);
+    float2 uvq = (input.local_position - sprite.bounds.origin) / sprite.bounds.size;
+    color.rgb = lerp(color.rgb, sprite.wash.rgb, sprite.wash.a);
+    float fade = saturate(lerp(lerp(sprite.fade.x, sprite.fade.y, uvq.x),
+                               lerp(sprite.fade.w, sprite.fade.z, uvq.x), uvq.y));
+    color.a *= sprite.opacity * fade * saturate(0.5 - distance);
+    return color;
+}
