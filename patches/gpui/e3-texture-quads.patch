+// --- texture sprites --- //
+
+// rox patch: paint_texture_quad, the polychrome sprite's perspective face
+// sampling a user texture instead of an atlas tile. `source` is the 0..1
+// crop, and a negative size samples backwards.
+struct TextureSprite {
+    order: u32,
+    texture_id: u32,
+    opacity: f32,
+    pad: u32,
+    bounds: Bounds,
+    content_mask: Bounds,
+    source: Bounds,
+    transformation: TransformationMatrix,
+    pad2: vec2<f32>,
+    perspective: vec4<f32>,
+    fade: vec4<f32>,
+    wash: vec4<f32>,
+}
+var<storage, read> b_tex_sprites: array<TextureSprite>;
+
+@vertex
+fn vs_tex_sprite(@builtin(vertex_index) vertex_id: u32, @builtin(instance_index) instance_id: u32) -> PolySpriteVarying {
+    let unit_vertex = vec2<f32>(f32(vertex_id & 1u), 0.5 * f32(vertex_id & 2u));
+    let sprite = b_tex_sprites[instance_id];
+
+    // Same projection as vs_poly_sprite.
+    var out = PolySpriteVarying();
+    let p = sprite.bounds.origin + unit_vertex * sprite.bounds.size;
+    let s = transpose(sprite.transformation.rotation_scale) * p + sprite.transformation.translation;
+    let w = sprite.perspective.z + dot(sprite.perspective.xy, p);
+    let dp = s / globals.viewport_size * vec2<f32>(2.0, -2.0);
+    out.position = vec4<f32>(dp + vec2<f32>(-1.0, 1.0) * w, 0.0, w);
+    out.tile_position = sprite.source.origin + unit_vertex * sprite.source.size;
+    out.sprite_id = instance_id;
+    out.local_position = p;
+    out.clip_distances = distance_from_clip_rect_impl(s / w, sprite.content_mask);
+    return out;
+}
+
+@fragment
+fn fs_tex_sprite(input: PolySpriteVarying) -> @location(0) vec4<f32> {
+    let sprite = b_tex_sprites[input.sprite_id];
+    // Held to the crop's texel centers like an atlas tile, so the edge
+    // fragments don't filter in texels outside it. Sorted first for a
+    // backwards crop.
+    let half_texel = 0.5 / vec2<f32>(textureDimensions(t_sprite, 0));
+    let edge_a = sprite.source.origin;
+    let edge_b = sprite.source.origin + sprite.source.size;
+    let uv = clamp(input.tile_position, min(edge_a, edge_b) + half_texel, max(edge_a, edge_b) - half_texel);
+    let sample = textureSample(t_sprite, s_sprite, uv);
+    // Alpha clip after using the derivatives.
+    if (any(input.clip_distances < vec4<f32>(0.0))) {
+        return vec4<f32>(0.0);
+    }
+
+    // User textures are Rgba8UnormSrgb, so the sample arrives linear. The
+    // atlas and the surface are plain Unorm holding sRGB-encoded values,
+    // which is what blend_color and the wash expect, so encode it back.
+    // Alpha is straight in both.
+    var color = vec4<f32>(linear_to_srgb(sample.rgb), sample.a);
+    color = vec4<f32>(mix(color.rgb, sprite.wash.rgb, sprite.wash.a), color.a);
+    let uvq = (input.local_position - sprite.bounds.origin) / sprite.bounds.size;
+    let fade = saturate(mix(
+        mix(sprite.fade.x, sprite.fade.y, uvq.x),
+        mix(sprite.fade.w, sprite.fade.z, uvq.x),
+        uvq.y,
+    ));
+    let distance = quad_sdf(input.local_position, sprite.bounds, Corners(0.0, 0.0, 0.0, 0.0));
+    return blend_color(color, sprite.opacity * fade * saturate(0.5 - distance));
+}
