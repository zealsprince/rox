+    /// and paints nothing, so check [`Window::user_shader_caps`] first. A quad
+    /// leaning past its own horizon paints nothing too.
+    ///
+    /// This method should only be called as part of the paint phase of
+    /// element drawing.
+    ///
+    /// rox patch: the in-scene shader primitive on a perspective face.
+    /// `fs_user(uv)` still sees 0..1 across it.
+    pub fn paint_user_shader_quad(
+        &mut self,
+        corners: [Point<Pixels>; 4],
+        shader: UserShaderId,
+        signals: [f32; 16],
+        meta: [f32; 8],
