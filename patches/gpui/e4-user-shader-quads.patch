+        use crate::UserShader;
+
+        self.invalidator.debug_assert_paint();
+
+        let Some(caps) = self.user_shaders.caps(shader) else {
+            return;
+        };
+        if caps.screen_pass_only() || self.user_shaders.primitive_source(shader).is_none() {
+            if self.user_shaders.first_quad_refusal(shader) {
+                log::warn!(
+                    "user shader {} only runs as a screen pass, so it can't paint on a quad",
+                    shader.0
