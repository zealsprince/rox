+/// rox patch: a texture this window allocated for another process to draw
+/// into, and everything that process needs to import it. Linux and FreeBSD
+/// only for now, over Vulkan: the memory is an opaque fd, which only the same
+/// driver on the same device can import (compare the UUIDs first), into an
+/// image made from exactly this create info with a dedicated allocation of
+/// `allocation_size` bytes from `memory_type`. 2D, one mip and one layer,
+/// exclusive sharing.
+///
+/// When the fd is handed out the image is in `layout` and released to
+/// `VK_QUEUE_FAMILY_EXTERNAL`. The importer acquires it from there before its
+/// first write. The window samples it through an sRGB view whenever it paints
+/// and never waits on the other process, so finish the GPU work on a frame
+/// before saying it's there.
+#[derive(Debug)]
+pub struct ExternalTexture {
+    /// The memory. Close-on-exec, so lending it to a child means placing a
+    /// copy at the number the child expects.
+    #[cfg(unix)]
+    pub fd: std::os::fd::OwnedFd,
+    /// The image's width in pixels.
+    pub width: u32,
+    /// The image's height in pixels.
+    pub height: u32,
+    /// The dedicated allocation's size in bytes.
+    pub allocation_size: u64,
+    /// The memory type index it was allocated from.
+    pub memory_type: u32,
+    /// `VkFormat` of the image.
+    pub format: i32,
+    /// `VkImageFormatListCreateInfo::pViewFormats`, in order.
+    pub view_formats: Vec<i32>,
+    /// `VkImageCreateFlags`.
+    pub flags: u32,
+    /// `VkImageUsageFlags`.
+    pub usage: u32,
+    /// `VkImageTiling`.
+    pub tiling: i32,
+    /// `VkImageLayout` the image is in, here and after every transfer.
+    pub layout: i32,
+    /// `VkPhysicalDeviceIDProperties::deviceUUID`.
+    pub device_uuid: [u8; 16],
+    /// `VkPhysicalDeviceIDProperties::driverUUID`.
+    pub driver_uuid: [u8; 16],
+}
