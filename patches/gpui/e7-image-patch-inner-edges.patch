+// rox patch: the distance past the nearest side not in `inner`, negative
+// inside, and far inside when every side is inner.
+fn soft_edge_distance(point: vec2<f32>, bounds: Bounds, inner: u32) -> f32 {
+    let near = bounds.origin - point;
+    let far = point - (bounds.origin + bounds.size);
+    var distance = -1e9;
+    if ((inner & 1u) == 0u) { distance = max(distance, near.x); }
+    if ((inner & 2u) == 0u) { distance = max(distance, near.y); }
+    if ((inner & 4u) == 0u) { distance = max(distance, far.x); }
+    if ((inner & 8u) == 0u) { distance = max(distance, far.y); }
+    return distance;
+}
