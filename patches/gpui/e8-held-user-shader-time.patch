+// rox patch: `pad` is alignment the GPU never reads, so it carries a held
+// time: the bits in the first word, and 1 in the second while one is held.
+impl UserShader {
+    pub(crate) fn holding(time: Option<f32>) -> [u32; 2] {
+        match time {
+            Some(time) => [time.to_bits(), 1],
+            None => [0; 2],
+        }
+    }
+
+    pub(crate) fn held_time(&self) -> Option<f32> {
+        (self.pad[1] == 1).then(|| f32::from_bits(self.pad[0]))
+    }
+}
