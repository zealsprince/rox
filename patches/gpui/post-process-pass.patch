+    #[test]
+    fn identity_shader_validates() {
+        let user = "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+            return textureSample(screen, samp, uv);
+        }";
+        let decorated = compose_post_shader_source(user, true);
+        validate_post_shader_source(&decorated).unwrap();
+    }
+
+    #[test]
+    fn signal_tint_shader_validates() {
+        let user = "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+            let base = textureSample(screen, samp, uv);
+            let bass = params.signals[0].x;
+            let tint = vec4<f32>(bass, 0.0, 0.0, 0.0) * sin(params.time);
+            return base + tint * base.a;
+        }";
+        let decorated = compose_post_shader_source(user, true);
+        validate_post_shader_source(&decorated).unwrap();
+    }
+
+    #[test]
+    fn broken_shader_reports_error() {
+        let user = "fn fs_user(uv: vec2<f32>) -> vec4<f32> { return uv; }";
+        let decorated = compose_post_shader_source(user, true);
+        let err = validate_post_shader_source(&decorated).unwrap_err();
+        assert!(!err.is_empty());
+    }
+
+    #[test]
