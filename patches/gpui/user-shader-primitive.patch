+/// rox patch: identifies a shader registered with
+/// [`Window::register_user_shader`]. Ids are local to the window that handed
+/// them out, since the compiled pipeline lives in that window's renderer.
+#[derive(Copy, Clone, Debug, Eq, PartialEq, Ord, PartialOrd, Hash)]
+pub struct UserShaderId(pub u32);
+
+// rox patch: template for the in-scene shader primitive. Same uniform block
+// as the post pass, but the vertex stage builds an instanced quad from the
+// scene's `UserShader` primitives and there is no screen texture to read.
+const USER_SHADER_TEMPLATE: &str = "
+struct ShaderParams {
+    time: f32,
+    _pad: f32,
+    resolution: vec2<f32>,
+    signals: array<vec4<f32>, 4>,
+}
+
+struct GlobalParams {
+    viewport_size: vec2<f32>,
+    premultiplied_alpha: u32,
+    pad: u32,
+}
+
+struct UserShaderBounds {
+    origin: vec2<f32>,
+    size: vec2<f32>,
+}
+
+struct UserShader {
+    order: u32,
+    shader_id: u32,
+    bounds: UserShaderBounds,
+    content_mask: UserShaderBounds,
+    signals: array<vec4<f32>, 4>,
+}
+
+struct UserShaderVarying {
+    @builtin(position) position: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+    @location(1) clip_distances: vec4<f32>,
+}
+
+@vertex
+fn vs_user_shader(
+    @builtin(vertex_index) vertex_id: u32,
+    @builtin(instance_index) instance_id: u32,
+) -> UserShaderVarying {
+    let unit_vertex = vec2<f32>(f32(vertex_id & 1u), 0.5 * f32(vertex_id & 2u));
+    let quad = b_user_shaders[instance_id];
+    let position = unit_vertex * quad.bounds.size + quad.bounds.origin;
+    let device_position =
+        position / globals.viewport_size * vec2<f32>(2.0, -2.0) + vec2<f32>(-1.0, 1.0);
+    let top_left = position - quad.content_mask.origin;
+    let bottom_right = quad.content_mask.origin + quad.content_mask.size - position;
+
+    var out = UserShaderVarying();
+    out.position = vec4<f32>(device_position, 0.0, 1.0);
+    out.uv = unit_vertex;
+    out.clip_distances = vec4<f32>(top_left.x, bottom_right.x, top_left.y, bottom_right.y);
+    return out;
+}
+
+@fragment
+fn fs_user_shader(input: UserShaderVarying) -> @location(0) vec4<f32> {
+    // Alpha clip first, the way the built-in primitives do: WGSL has no
+    // clip_distance here either.
+    if (any(input.clip_distances < vec4<f32>(0.0))) {
+        return vec4<f32>(0.0);
+    }
+    return fs_user(input.uv);
+}
+";
+
+// Same two-variant trick as the post pass: naga wants explicit bind points on
+// a standalone module, blade assigns them from the pipeline's data layout.
+fn compose_user_shader_source(user_source: &str, decorated: bool) -> String {
+    let bindings = if decorated {
+        "@group(0) @binding(0) var<uniform> globals: GlobalParams;\n\
+         @group(0) @binding(1) var<uniform> params: ShaderParams;\n\
+         @group(0) @binding(2) var<storage, read> b_user_shaders: array<UserShader>;\n"
+    } else {
+        "var<uniform> globals: GlobalParams;\n\
+         var<uniform> params: ShaderParams;\n\
+         var<storage, read> b_user_shaders: array<UserShader>;\n"
+    };
+    format!("{USER_SHADER_TEMPLATE}\n{bindings}\n{user_source}")
+}
+
+/// rox patch: one entry per registered shader. Both composed variants are
+/// kept as text, because the renderer rebuilds pipelines whenever the surface
+/// is reconfigured.
+pub(crate) struct UserShaderEntry {
+    post_source: String,
+    // `None` for a shader that samples the screen texture: there is no such
+    // texture in scene space, so it can only ever run as a post pass.
+    primitive_source: Option<String>,
+}
+
+/// rox patch: this window's user shaders, keyed by source content so the same
+/// text registered twice compiles once.
+#[derive(Default)]
+pub(crate) struct UserShaderRegistry {
+    by_hash: std::collections::HashMap<u64, UserShaderId>,
+    entries: Vec<UserShaderEntry>,
+}
+
+impl UserShaderRegistry {
+    fn entry(&self, id: UserShaderId) -> Option<&UserShaderEntry> {
+        self.entries.get(id.0 as usize)
+    }
+
+    /// The composed module for the whole-window post pass.
+    pub(crate) fn post_source(&self, id: UserShaderId) -> Option<&str> {
+        self.entry(id).map(|entry| entry.post_source.as_str())
+    }
+
+    /// The composed module for the in-scene primitive, absent for a
+    /// screen-sampling (post-only) shader.
+    pub(crate) fn primitive_source(&self, id: UserShaderId) -> Option<&str> {
+        self.entry(id)
+            .and_then(|entry| entry.primitive_source.as_deref())
+    }
+
+    /// Registers `source`, returning its id and whether this call is what
+    /// created it. Re-registering the same text is a lookup, not a compile.
+    #[cfg(any(target_os = "linux", target_os = "freebsd"))]
+    fn register(&mut self, source: &str) -> std::result::Result<(UserShaderId, bool), String> {
+        use std::hash::{Hash as _, Hasher as _};
+
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        source.hash(&mut hasher);
+        let hash = hasher.finish();
+        if let Some(id) = self.by_hash.get(&hash) {
+            return Ok((*id, false));
+        }
+
+        // The post variant is the superset (params plus the screen texture and
+        // its sampler), so it's what decides whether the source is valid at
+        // all, and its globals are what the guard below compares against.
+        let post_decorated = compose_post_shader_source(source, true);
+        let module = validate_shader_source(&post_decorated)?;
+        // A shader declaring its own module-scope variables passes validation
+        // and then panics blade's pipeline layout match, so it stops here.
+        for variable in module.global_variables.iter() {
+            let name = variable.1.name.as_deref().unwrap_or_default();
+            if !matches!(name, "params" | "screen" | "samp") {
+                return Err(format!(
+                    "user shaders can't declare module-scope variables, found `{name}`; \
+                     the template provides params, screen and samp"
+                ));
+            }
+        }
+
+        // A shader that reads `screen` won't resolve against the primitive
+        // template, which is exactly how a post-only shader identifies itself.
+        let primitive_decorated = compose_user_shader_source(source, true);
+        let primitive_source = validate_shader_source(&primitive_decorated)
+            .ok()
+            .map(|_| compose_user_shader_source(source, false));
+
+        let id = UserShaderId(self.entries.len() as u32);
+        self.entries.push(UserShaderEntry {
+            post_source: compose_post_shader_source(source, false),
+            primitive_source,
+        });
+        self.by_hash.insert(hash, id);
+        Ok((id, true))
+    }
+}
+
+#[cfg(all(test, any(target_os = "linux", target_os = "freebsd")))]
+mod user_shader_registry_tests {
+    use super::*;
+
+    const SOLID: &str = "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+        return vec4<f32>(uv.x, uv.y, 1.0, 1.0);
+    }";
+
+    #[test]
+    fn valid_source_registers_and_is_paintable() {
+        let mut registry = UserShaderRegistry::default();
+        let (id, is_new) = registry.register(SOLID).unwrap();
+        assert_eq!(id, UserShaderId(0));
+        assert!(is_new);
+        assert!(registry.primitive_source(id).is_some());
+        assert!(registry.post_source(id).is_some());
+    }
+
+    #[test]
+    fn same_source_returns_same_id() {
+        let mut registry = UserShaderRegistry::default();
+        let (first, first_new) = registry.register(SOLID).unwrap();
+        let (second, second_new) = registry.register(SOLID).unwrap();
+        assert_eq!(first, second);
+        assert!(first_new);
+        assert!(!second_new);
+        assert_eq!(registry.entries.len(), 1);
+    }
+
+    #[test]
+    fn distinct_sources_get_distinct_ids() {
+        let mut registry = UserShaderRegistry::default();
+        let (first, _) = registry.register(SOLID).unwrap();
+        let (second, _) = registry
+            .register("fn fs_user(uv: vec2<f32>) -> vec4<f32> { return vec4<f32>(1.0); }")
+            .unwrap();
+        assert_ne!(first, second);
+        assert_eq!(second, UserShaderId(1));
+    }
+
+    #[test]
+    fn invalid_source_returns_the_naga_message() {
+        let mut registry = UserShaderRegistry::default();
+        let error = registry
+            .register("fn fs_user(uv: vec2<f32>) -> vec4<f32> { return uv; }")
+            .unwrap_err();
+        assert!(error.contains("error"), "{error}");
+        assert!(registry.entries.is_empty());
+    }
+
+    #[test]
+    fn missing_entry_point_is_rejected() {
+        let mut registry = UserShaderRegistry::default();
+        assert!(registry.register("").is_err());
+    }
+
+    #[test]
+    fn extra_module_scope_variable_is_rejected() {
+        let mut registry = UserShaderRegistry::default();
+        let error = registry
+            .register(
+                "var<private> scratch: f32;
+                 fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+                     return vec4<f32>(scratch, uv.y, 0.0, 1.0);
+                 }",
+            )
+            .unwrap_err();
+        assert!(error.contains("scratch"), "{error}");
+        assert!(registry.entries.is_empty());
+    }
+
+    #[test]
+    fn screen_sampling_source_is_post_only() {
+        let mut registry = UserShaderRegistry::default();
+        let (id, _) = registry
+            .register(
+                "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+                     return textureSample(screen, samp, uv);
+                 }",
+            )
+            .unwrap();
+        assert!(registry.primitive_source(id).is_none());
+        assert!(registry.post_source(id).is_some());
+    }
+
+    #[test]
+    fn signals_and_time_reach_the_primitive_variant() {
+        let mut registry = UserShaderRegistry::default();
+        let (id, _) = registry
+            .register(
+                "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+                     let bass = params.signals[0].x;
+                     let wobble = sin(params.time) * params.resolution.x;
+                     return vec4<f32>(bass, uv.x, wobble, 1.0);
+                 }",
+            )
+            .unwrap();
+        assert!(registry.primitive_source(id).is_some());
+        assert!(registry.primitive_source(UserShaderId(42)).is_none());
     }
