+
+fn create_user_shader_pipeline(
+    gpu: &gpu::Context,
+    surface_info: gpu::SurfaceInfo,
+    source: &str,
+) -> gpu::RenderPipeline {
+    use gpu::ShaderData as _;
+
+    let shader = gpu.create_shader(gpu::ShaderDesc { source });
+    shader.check_struct_size::<GlobalParams>();
+    shader.check_struct_size::<ShaderParams>();
+    shader.check_struct_size::<UserShader>();
+
+    gpu.create_render_pipeline(gpu::RenderPipelineDesc {
+        name: "user-shader",
+        data_layouts: &[&ShaderUserData::layout()],
+        vertex: shader.at("vs_user_shader"),
+        vertex_fetches: &[],
+        primitive: gpu::PrimitiveState {
+            topology: gpu::PrimitiveTopology::TriangleStrip,
+            ..Default::default()
+        },
+        depth_stencil: None,
+        fragment: Some(shader.at("fs_user_shader")),
+        // Fixed at premultiplied-over: the contract says user output is
+        // premultiplied, and an in-scene quad composites over what's under it.
+        color_targets: &[gpu::ColorTargetState {
+            format: surface_info.format,
+            blend: Some(gpu::BlendState::PREMULTIPLIED_ALPHA_BLENDING),
+            write_mask: gpu::ColorWrites::default(),
+        }],
+        multisample_state: gpu::MultisampleState::default(),
     })
 }
 
