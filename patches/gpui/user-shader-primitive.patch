+/// rox patch: one instance of a user-registered shader, drawn as a quad
+/// through a runtime-compiled pipeline. Layout matches the `UserShader`
+/// struct the shader template declares, hence the explicit padding: WGSL
+/// aligns the signal array to 16 bytes and Rust would not.
+#[derive(Clone, Debug)]
+#[repr(C)]
+pub(crate) struct UserShader {
+    pub order: DrawOrder,
+    pub shader_id: u32,
+    pub bounds: Bounds<ScaledPixels>,
+    pub content_mask: ContentMask<ScaledPixels>,
+    pub pad: [u32; 2],
+    pub params: [f32; 16],
+}
+
+impl From<UserShader> for Primitive {
+    fn from(user_shader: UserShader) -> Self {
+        Primitive::UserShader(user_shader)
