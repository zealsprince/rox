+
+// Straight copy of an intermediate onto the swapchain. Needed because the
+// surface texture isn't a copy destination, so "no post shader but there were
+// region passes" still has to get the composed image across as a draw.
+const BLIT_SHADER: &str = "
+var screen: texture_2d<f32>;
+var samp: sampler;
+
+struct BlitVarying {
+    @builtin(position) position: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+}
+
+@vertex
+fn vs_blit(@builtin(vertex_index) vertex_id: u32) -> BlitVarying {
+    let corner = vec2<f32>(f32((vertex_id << 1u) & 2u), f32(vertex_id & 2u));
+    var out = BlitVarying();
+    out.position = vec4<f32>(corner.x * 2.0 - 1.0, 1.0 - corner.y * 2.0, 0.0, 1.0);
+    out.uv = corner;
+    return out;
+}
+
+@fragment
+fn fs_blit(input: BlitVarying) -> @location(0) vec4<f32> {
+    return textureSample(screen, samp, input.uv);
+}
+";
+
+// A shader's clock. Every step is capped so one long-parked frame doesn't
+// jump time, and `delta` is that same capped step - zero on the first tick.
+#[derive(Default)]
+struct ShaderClock {
+    time: f32,
+    delta: f32,
+    last: Option<std::time::Instant>,
+}
+
+impl ShaderClock {
+    fn tick(&mut self) {
+        let now = std::time::Instant::now();
+        self.delta = match self.last {
+            Some(last) => now.duration_since(last).as_secs_f32().min(0.1),
+            None => 0.0,
+        };
+        self.time += self.delta;
+        self.last = Some(now);
+    }
+}
