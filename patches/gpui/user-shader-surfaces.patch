+    fn prev_only_source_still_needs_a_screen_pass() {
+        let mut registry = UserShaderRegistry::default();
+        let (id, _) = registry
+            .register(
+                "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+                     return textureSample(prev, samp, uv) * 0.98;
+                 }",
+            )
+            .unwrap();
+        let caps = registry.caps(id).unwrap();
+        assert!(caps.uses_prev);
+        assert!(!caps.samples_screen);
+        assert!(registry.primitive_source(id).is_none());
+    }
+
+    #[test]
+    fn caps_are_false_for_a_pure_shader_and_none_for_an_unknown_id() {
+        let mut registry = UserShaderRegistry::default();
+        let (id, _) = registry.register(SOLID).unwrap();
+        assert_eq!(
+            registry.caps(id),
+            Some(UserShaderCaps {
+                samples_screen: false,
+                uses_prev: false,
+            })
+        );
+        assert_eq!(registry.caps(UserShaderId(7)), None);
+        // A pure shader binds no textures, so its screen module must not
+        // declare `prev`.
+        assert!(!registry.screen_source(id).unwrap().contains("prev"));
+    }
+
+    #[test]
+    fn the_region_variant_compiles_once() {
+        let mut registry = UserShaderRegistry::default();
+        let (id, _) = registry.register(SOLID).unwrap();
+        assert!(registry.take_pending_screen_source(id).is_some());
+        assert!(registry.take_pending_screen_source(id).is_none());
+        assert!(registry.take_pending_screen_source(UserShaderId(9)).is_none());
+    }
+
+    #[test]
+    fn the_superset_template_puts_prev_in_scope() {
+        let user = "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+            return textureSample(prev, samp, uv);
+        }";
+        let decorated = compose_screen_shader_source(user, true, SCREEN_SUPERSET);
+        validate_shader_source(&decorated).unwrap();
+    }
+
+    #[test]
+    fn the_params_block_is_128_bytes_in_wgsl() {
+        // The Rust mirror lives in `blade_renderer.rs`, which only builds on
+        // blade platforms; this pins the WGSL half, and blade's
+        // `check_struct_size` pins them to each other at pipeline creation.
+        let user = "fn fs_user(uv: vec2<f32>) -> vec4<f32> { return vec4<f32>(uv, 0.0, 1.0); }";
+        let module =
+            validate_shader_source(&compose_screen_shader_source(user, true, SCREEN_SUPERSET))
+                .unwrap();
+        let params = module
+            .types
+            .iter()
+            .find(|(_, ty)| ty.name.as_deref() == Some("ShaderParams"))
+            .expect("ShaderParams in the template");
+        let naga::TypeInner::Struct { span, .. } = params.1.inner else {
+            panic!("ShaderParams should be a struct");
+        };
+        assert_eq!(span, 128);
+    }
+
+    #[test]
+    fn the_primitive_instance_block_is_160_bytes_in_wgsl() {
+        // Mirrors `scene::UserShader`, which has a matching compile-time
+        // assertion on the Rust side.
+        let user = "fn fs_user(uv: vec2<f32>) -> vec4<f32> { return vec4<f32>(uv, 0.0, 1.0); }";
+        let module = validate_shader_source(&compose_user_shader_source(user, true)).unwrap();
+        let quad = module
+            .types
+            .iter()
+            .find(|(_, ty)| ty.name.as_deref() == Some("UserShader"))
+            .expect("UserShader in the template");
+        let naga::TypeInner::Struct { span, .. } = quad.1.inner else {
+            panic!("UserShader should be a struct");
+        };
+        assert_eq!(span, 160);
+    }
 }
