+    /// Re-runs one registered shader over everything already composed under
+    /// `region.bounds`, writing back into the same intermediate.
+    fn draw_shader_region(
+        &mut self,
+        region: &UserShaderRegion,
+        target: gpu::Texture,
+        target_view: gpu::TextureView,
+    ) {
+        if !self.region_shaders.contains_key(&region.shader_id) {
+            return;
+        }
+
+        let surface_width = self.surface_config.size.width as i32;
+        let surface_height = self.surface_config.size.height as i32;
+        let left = region.bounds.origin.x.0.round() as i32;
+        let top = region.bounds.origin.y.0.round() as i32;
+        let width = region.bounds.size.width.0.round().max(0.0) as u32;
+        let height = region.bounds.size.height.0.round().max(0.0) as u32;
+        if width == 0 || height == 0 {
+            return;
+        }
+
+        // The copy takes whatever part of the bounds is actually on screen;
+        // the shader still sees uv 0..1 across the whole bounds, so a panel
+        // hanging off the edge reads transparent black out there rather than
+        // a stretched image.
+        let copy_left = left.max(0);
+        let copy_top = top.max(0);
+        let copy_right = (left + width as i32).min(surface_width);
+        let copy_bottom = (top + height as i32).min(surface_height);
+        if copy_right <= copy_left || copy_bottom <= copy_top {
+            return;
+        }
+
+        // Everything outside the content mask belongs to whoever drew it, so
+        // the scissor is what keeps this pass inside its own lane.
+        let mask = region.content_mask.bounds;
+        let clip_left = left.max(mask.origin.x.0.round() as i32).max(0);
+        let clip_top = top.max(mask.origin.y.0.round() as i32).max(0);
+        let clip_right = (left + width as i32)
+            .min((mask.origin.x.0 + mask.size.width.0).round() as i32)
+            .min(surface_width);
+        let clip_bottom = (top + height as i32)
+            .min((mask.origin.y.0 + mask.size.height.0).round() as i32)
+            .min(surface_height);
+        if clip_right <= clip_left || clip_bottom <= clip_top {
+            return;
+        }
+
+        self.ensure_region_instance(region, width, height);
+
+        let shader = &self.region_shaders[&region.shader_id];
+        let Some(instance) = self.region_instances.get_mut(&region.instance) else {
+            return;
+        };
+        instance.clock.tick();
+        let params = ShaderParams {
+            time: instance.clock.time,
+            delta: instance.clock.delta,
+            resolution: [width as f32, height as f32],
+            mouse: region.mouse,
+            meta: bytemuck::cast(region.meta),
+            signals: bytemuck::cast(region.signals),
+        };
+
+        let copy_extent = gpu::Extent {
+            width: (copy_right - copy_left) as u32,
+            height: (copy_bottom - copy_top) as u32,
+            depth: 1,
+        };
