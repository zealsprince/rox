+// Same pass, plus the shader's own previous output. A separate layout because
+// blade matches the bind group against the module's globals, and the composed
+// source only declares `prev` when the shader actually reads it.
+#[derive(blade_macros::ShaderData)]
+struct ShaderPostPrevData {
+    params: ShaderParams,
+    screen: gpu::TextureView,
+    samp: gpu::Sampler,
+    prev: gpu::TextureView,
