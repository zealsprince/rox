+        #[test]
+        fn a_chain_pass_translates_and_compiles() {
+            let mut registry = UserShaderRegistry::default();
+            let (id, _) = registry.register_chain(&everything_chain()).unwrap();
+            for pass in &registry.entries[id.0 as usize].passes {
+                let bindings = pass
+                    .bindings
+                    .iter()
+                    .map(HlslBinding::for_chain)
+                    .collect::<Vec<_>>();
+                compiles(&pass.decorated, &bindings);
+            }
+        }
