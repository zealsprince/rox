+        use crate::platform::windows_shader_translate::{
+            self as shader_translate, FRAGMENT_PROFILE, HlslBinding, PRIMITIVE_BINDINGS,
+            VERTEX_PROFILE,
+        };
+
+        fn compiles(source: &str, bindings: &[HlslBinding]) {
+            let translated = shader_translate::translate(source, bindings)
+                .unwrap_or_else(|err| panic!("translation failed: {err}"));
+            for (entry, profile) in [
+                (&translated.vertex_entry, VERTEX_PROFILE),
+                (&translated.fragment_entry, FRAGMENT_PROFILE),
+            ] {
+                shader_translate::compile(&translated.source, entry, profile).unwrap_or_else(
+                    |err| panic!("{profile} compile failed: {err}\n{}", translated.source),
+                );
+            }
+        }
