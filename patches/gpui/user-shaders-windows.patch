+    // A chain pass that reaches for everything a pass can have: the composed
+    // frame, its own last output, the pass ahead of it and a declared image.
+    const EVERYTHING: &str = "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+        return textureSample(screen, samp, uv)
+             + textureSample(prev, samp, uv)
+             + textureSample(first, samp, uv)
+             + textureSample(plate, samp, uv);
+    }";
+
+    fn everything_chain() -> UserShaderChain {
+        UserShaderChain {
+            passes: vec![
+                pass(
+                    "first",
+                    "fn fs_user(uv: vec2<f32>) -> vec4<f32> {
+                         return textureSample(screen, samp, uv);
+                     }",
+                    0.5,
+                ),
+                pass("out", EVERYTHING, 1.0),
+            ],
+            assets: vec![("plate".to_string(), UserTextureId(7))],
+        }
+    }
+
+    #[test]
+    fn the_decorated_variant_numbers_bindings_in_the_pinned_order() {
+        let mut registry = UserShaderRegistry::default();
+        let (id, _) = registry.register_chain(&everything_chain()).unwrap();
+        let last = registry.entries[id.0 as usize].passes.last().unwrap();
+
+        // What a translating backend derives its register map from: the
+        // `@binding(n)` on each global is that global's index into
+        // `bindings`, so the two walk in lockstep.
+        assert_eq!(
+            last.bindings,
+            vec![
+                ChainBinding::Params,
+                ChainBinding::Screen,
+                ChainBinding::Sampler,
+                ChainBinding::Prev,
+                ChainBinding::Pass {
+                    index: 0,
+                    name: "first".to_string()
+                },
+                ChainBinding::Asset {
+                    id: 7,
+                    name: "plate".to_string()
+                },
+            ]
+        );
+        for (slot, declaration) in [
+            "var<uniform> params: ShaderParams;",
+            "var screen: texture_2d<f32>;",
+            "var samp: sampler;",
+            "var prev: texture_2d<f32>;",
+            "var first: texture_2d<f32>;",
+            "var plate: texture_2d<f32>;",
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let expected = format!("@group(0) @binding({slot}) {declaration}");
+            assert!(
+                last.decorated.contains(&expected),
+                "missing `{expected}` in:\n{}",
+                last.decorated
+            );
+        }
+        // The bare variant is what blade takes, and carries no decorations.
+        assert!(!last.source.contains("@group("));
+    }
