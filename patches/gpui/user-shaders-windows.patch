+/// A caller-registered image. Lives until the window closes; v1 never evicts.
+/// The pixels stay around so a lost device can re-upload without the caller
+/// registering again.
+struct UserTexture {
+    srv: [Option<ID3D11ShaderResourceView>; 1],
+    width: u32,
+    height: u32,
+    pixels: Vec<u8>,
+}
+
+/// The instance buffer the in-scene primitive reads. naga turns a WGSL storage
+/// binding into a `ByteAddressBuffer`, so this is a raw view rather than the
+/// structured ones the built-in pipelines use.
+struct RawBuffer {
+    buffer: ID3D11Buffer,
+    view: [Option<ID3D11ShaderResourceView>; 1],
+    capacity: usize,
+}
+
+impl RawBuffer {
+    fn new(device: &ID3D11Device, bytes: usize) -> Result<Self> {
+        let bytes = bytes.max(16).next_power_of_two();
+        let desc = D3D11_BUFFER_DESC {
+            ByteWidth: bytes as u32,
+            Usage: D3D11_USAGE_DYNAMIC,
+            BindFlags: D3D11_BIND_SHADER_RESOURCE.0 as u32,
+            CPUAccessFlags: D3D11_CPU_ACCESS_WRITE.0 as u32,
+            MiscFlags: D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS.0 as u32,
+            StructureByteStride: 0,
+        };
+        let buffer = unsafe {
+            let mut buffer = None;
+            device.CreateBuffer(&desc, None, Some(&mut buffer))?;
+            buffer.unwrap()
+        };
+        let view_desc = D3D11_SHADER_RESOURCE_VIEW_DESC {
+            Format: DXGI_FORMAT_R32_TYPELESS,
+            ViewDimension: D3D11_SRV_DIMENSION_BUFFEREX,
+            Anonymous: D3D11_SHADER_RESOURCE_VIEW_DESC_0 {
+                BufferEx: D3D11_BUFFEREX_SRV {
+                    FirstElement: 0,
+                    NumElements: (bytes / 4) as u32,
+                    Flags: D3D11_BUFFEREX_SRV_FLAG_RAW.0 as u32,
+                },
+            },
+        };
+        let view = unsafe {
+            let mut view = None;
+            device.CreateShaderResourceView(&buffer, Some(&view_desc), Some(&mut view))?;
+            [view]
+        };
+        Ok(Self {
+            buffer,
+            view,
+            capacity: bytes,
+        })
+    }
+}
+
+/// Everything the user shader pipeline owns for one window.
+struct DirectXUserShaders {
+    /// False on a device that can't reach shader model 5.0. Registration
+    /// returns `"unsupported"` and rox shows the banner it already has.
+    supported: bool,
+    sampler: [Option<ID3D11SamplerState>; 1],
+    /// Premultiplied-over, the same compose the blade pipelines use: it lets a
+    /// transparent program ride the frame under it wherever the target arrives
+    /// loaded, and it's the identity on a target that was just cleared.
+    blend: ID3D11BlendState,
+    /// No blending at all, for the straight copies.
+    replace_blend: ID3D11BlendState,
+    scissor_rasterizer: ID3D11RasterizerState,
+    plain_rasterizer: ID3D11RasterizerState,
+    params_buffer: [Option<ID3D11Buffer>; 1],
+    globals_buffer: [Option<ID3D11Buffer>; 1],
+    instances: Option<RawBuffer>,
+    blit: Option<(ID3D11VertexShader, ID3D11PixelShader)>,
+
+    primitives: HashMap<u32, PrimitiveProgram>,
+    chains: HashMap<u32, ShaderChain>,
+    textures: HashMap<u32, UserTexture>,
+    regions: HashMap<u64, RegionInstance>,
+
+    post: Option<PostProgram>,
+    post_signals: [f32; 16],
+    post_meta: [f32; 8],
+    post_mouse: [f32; 4],
+    post_targets: Vec<ChainPassTarget>,
+    // Ping-pong pair for a post chain that reads `prev`: this frame renders
+    // into one and samples the other, then they swap.
+    post_prev: Option<[RenderTexture; 2]>,
+    post_prev_index: usize,
+
+    scene: Option<RenderTexture>,
+}
+
+impl DirectXUserShaders {
+    fn new(device: &ID3D11Device, feature_level: D3D_FEATURE_LEVEL) -> Result<Self> {
+        let sampler = unsafe {
+            let desc = D3D11_SAMPLER_DESC {
+                Filter: D3D11_FILTER_MIN_MAG_MIP_LINEAR,
+                // Clamped rather than wrapped: a pass reading outside its own
+                // bounds should see the edge, not the far side.
+                AddressU: D3D11_TEXTURE_ADDRESS_CLAMP,
+                AddressV: D3D11_TEXTURE_ADDRESS_CLAMP,
+                AddressW: D3D11_TEXTURE_ADDRESS_CLAMP,
+                MipLODBias: 0.0,
+                MaxAnisotropy: 1,
+                ComparisonFunc: D3D11_COMPARISON_ALWAYS,
+                BorderColor: [0.0; 4],
+                MinLOD: 0.0,
+                MaxLOD: D3D11_FLOAT32_MAX,
+            };
+            let mut output = None;
+            device.CreateSamplerState(&desc, Some(&mut output))?;
+            [output]
+        };
+
+        Ok(Self {
+            supported: feature_level_runs_user_shaders(feature_level),
+            sampler,
+            blend: create_premultiplied_blend_state(device)?,
+            replace_blend: create_replace_blend_state(device)?,
+            scissor_rasterizer: create_rasterizer_state(device, true)?,
+            plain_rasterizer: create_rasterizer_state(device, false)?,
+            params_buffer: create_constant_buffer::<UserShaderParams>(device)?,
+            globals_buffer: create_constant_buffer::<UserGlobalParams>(device)?,
+            instances: None,
+            blit: None,
+            primitives: HashMap::default(),
+            chains: HashMap::default(),
+            textures: HashMap::default(),
+            regions: HashMap::default(),
+            post: None,
+            post_signals: [0.0; 16],
+            post_meta: [0.0; 8],
+            post_mouse: [0.0; 4],
+            post_targets: Vec::new(),
+            post_prev: None,
+            post_prev_index: 0,
+            scene: None,
+        })
+    }
+
+    /// Throws away everything sized to the window or to a region's bounds. The
+    /// next frame allocates what it needs again, so trails restart rather than
+    /// smearing the old size.
+    fn discard_sized_resources(&mut self) {
+        self.scene = None;
+        self.post_targets.clear();
+        self.post_prev = None;
+        self.post_prev_index = 0;
+        self.regions.clear();
+    }
+
+    /// Moves the registered programs onto a fresh device: pipelines rebuild
+    /// from the bytecode they kept and images from their pixels, so a device
+    /// loss doesn't make the caller register anything twice.
+    fn rebuild_onto(&mut self, mut fresh: Self, device: &ID3D11Device) {
+        for (id, program) in self.primitives.drain() {
+            if let Ok((vertex, fragment)) = program.bytecode.stages(device).log_err_owned() {
+                fresh.primitives.insert(
+                    id,
+                    PrimitiveProgram {
+                        vertex,
+                        fragment,
+                        bytecode: program.bytecode,
+                        clock: ShaderClock::default(),
+                    },
+                );
+            }
+        }
+        for (id, chain) in self.chains.drain() {
+            if let Some(chain) = rebuild_chain(device, chain) {
+                fresh.chains.insert(id, chain);
+            }
+        }
+        for (id, texture) in self.textures.drain() {
+            if let Some(rebuilt) =
+                create_user_texture(device, texture.width, texture.height, &texture.pixels)
+            {
+                fresh.textures.insert(id, rebuilt);
+            }
+        }
+        if let Some(post) = self.post.take()
+            && let Some(chain) = rebuild_chain(device, post.chain)
+        {
+            fresh.post = Some(PostProgram {
+                chain,
+                clock: ShaderClock::default(),
+            });
+        }
+        fresh.post_signals = self.post_signals;
+        fresh.post_meta = self.post_meta;
+        fresh.post_mouse = self.post_mouse;
+        *self = fresh;
+    }
+}
+
+/// Recompiles every pass of a chain onto a new device, dropping the whole
+/// program if any pass fails - a half-built chain would draw nonsense.
+fn rebuild_chain(device: &ID3D11Device, chain: ShaderChain) -> Option<ShaderChain> {
+    let mut passes = Vec::with_capacity(chain.passes.len());
+    for pass in chain.passes {
+        let (vertex, fragment) = pass.bytecode.stages(device).log_err_owned().ok()?;
+        passes.push(ChainPass {
+            vertex,
+            fragment,
+            bytecode: pass.bytecode,
+            scale: pass.scale,
+            bindings: pass.bindings,
+        });
+    }
+    Some(ShaderChain { passes })
+}
+
+fn create_user_texture(
+    device: &ID3D11Device,
+    width: u32,
+    height: u32,
+    rgba8: &[u8],
+) -> Option<UserTexture> {
+    let data = D3D11_SUBRESOURCE_DATA {
+        pSysMem: rgba8.as_ptr() as *const _,
+        SysMemPitch: width * 4,
+        SysMemSlicePitch: 0,
+    };
+    let desc = D3D11_TEXTURE2D_DESC {
+        Width: width,
+        Height: height,
+        MipLevels: 1,
+        ArraySize: 1,
+        // Straight-alpha bytes read as sRGB, the same format the blade path
+        // uploads them under, so an asset samples identically on both.
+        Format: DXGI_FORMAT_R8G8B8A8_UNORM_SRGB,
+        SampleDesc: DXGI_SAMPLE_DESC {
+            Count: 1,
+            Quality: 0,
+        },
+        Usage: D3D11_USAGE_IMMUTABLE,
+        BindFlags: D3D11_BIND_SHADER_RESOURCE.0 as u32,
+        CPUAccessFlags: 0,
+        MiscFlags: 0,
+    };
+    let texture = unsafe {
+        let mut output = None;
+        device
+            .CreateTexture2D(&desc, Some(&data), Some(&mut output))
+            .log_err()?;
+        output?
+    };
+    let srv = unsafe {
+        let mut view = None;
+        device
+            .CreateShaderResourceView(&texture, None, Some(&mut view))
+            .log_err()?;
+        [view]
+    };
+    Some(UserTexture {
+        srv,
+        width,
+        height,
+        pixels: rgba8.to_vec(),
+    })
+}
+
+/// A pass target's size at its scale, never smaller than one pixel.
+fn scaled_size(size: u32, scale: f32) -> u32 {
+    ((size as f32 * scale).round() as u32).max(1)
+}
+
+#[inline]
+fn create_constant_buffer<T>(device: &ID3D11Device) -> Result<[Option<ID3D11Buffer>; 1]> {
+    let desc = D3D11_BUFFER_DESC {
+        ByteWidth: std::mem::size_of::<T>() as u32,
+        Usage: D3D11_USAGE_DYNAMIC,
+        BindFlags: D3D11_BIND_CONSTANT_BUFFER.0 as u32,
+        CPUAccessFlags: D3D11_CPU_ACCESS_WRITE.0 as u32,
+        ..Default::default()
+    };
+    unsafe {
+        let mut buffer = None;
+        device.CreateBuffer(&desc, None, Some(&mut buffer))?;
+        Ok([buffer])
+    }
+}
+
+#[inline]
+fn create_premultiplied_blend_state(device: &ID3D11Device) -> Result<ID3D11BlendState> {
+    let mut desc = D3D11_BLEND_DESC::default();
+    desc.RenderTarget[0].BlendEnable = true.into();
+    desc.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+    desc.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    desc.RenderTarget[0].SrcBlend = D3D11_BLEND_ONE;
+    desc.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
+    desc.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
+    desc.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_INV_SRC_ALPHA;
+    desc.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL.0 as u8;
+    unsafe {
+        let mut state = None;
+        device.CreateBlendState(&desc, Some(&mut state))?;
+        Ok(state.unwrap())
+    }
+}
+
+#[inline]
+fn create_replace_blend_state(device: &ID3D11Device) -> Result<ID3D11BlendState> {
+    let mut desc = D3D11_BLEND_DESC::default();
+    desc.RenderTarget[0].BlendEnable = false.into();
+    desc.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL.0 as u8;
+    unsafe {
+        let mut state = None;
+        device.CreateBlendState(&desc, Some(&mut state))?;
+        Ok(state.unwrap())
+    }
+}
+
+/// Straight copy of one texture onto a render target, as a draw rather than a
+/// transfer because the swapchain texture isn't a copy destination.
+const BLIT_HLSL: &str = r#"
+Texture2D<float4> screen : register(t0);
+SamplerState samp : register(s0);
+
+struct BlitVarying {
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+BlitVarying blit_vertex(uint vertex_id : SV_VertexID) {
+    float2 corner = float2(float((vertex_id << 1u) & 2u), float(vertex_id & 2u));
+    BlitVarying output;
+    output.position = float4(corner.x * 2.0 - 1.0, 1.0 - corner.y * 2.0, 0.0, 1.0);
+    output.uv = corner;
+    return output;
+}
+
+float4 blit_fragment(BlitVarying input) : SV_Target {
+    return screen.Sample(samp, input.uv);
+}
+"#;
+
+fn full_viewport(width: u32, height: u32) -> [D3D11_VIEWPORT; 1] {
+    [D3D11_VIEWPORT {
+        TopLeftX: 0.0,
+        TopLeftY: 0.0,
+        Width: width as f32,
+        Height: height as f32,
+        MinDepth: 0.0,
+        MaxDepth: 1.0,
+    }]
+}
+
+/// Unbinds the pixel-stage textures a shader pass left behind, so the next
+/// thing that wants one of them as a render target doesn't collide with its
+/// own SRV.
+fn release_shader_resources(context: &ID3D11DeviceContext, count: usize) {
+    if count == 0 {
+        return;
+    }
+    let empty = vec![None; count];
+    unsafe { context.PSSetShaderResources(0, Some(&empty)) };
+}
+
+/// Gathers a pass's texture views in the pinned order its registers were
+/// assigned in. `None` when something it needs is missing, either an asset
+/// that was never registered or an intermediate that failed to allocate,
+/// which skips the whole program for the frame.
+fn chain_pass_resources(
+    bindings: &[ChainBinding],
+    screen: Option<&ID3D11ShaderResourceView>,
+    prev_override: Option<&ID3D11ShaderResourceView>,
+    targets: &[ChainPassTarget],
+    index: usize,
+    textures: &HashMap<u32, UserTexture>,
+) -> Option<Vec<Option<ID3D11ShaderResourceView>>> {
+    let mut views = Vec::with_capacity(bindings.len());
+    for binding in bindings {
+        match binding {
+            // The uniform block and the sampler have registers of their own.
+            ChainBinding::Params | ChainBinding::Sampler => {}
+            ChainBinding::Screen => views.push(Some(screen?.clone())),
+            ChainBinding::Prev => views.push(Some(match prev_override {
+                Some(view) => view.clone(),
+                None => targets.get(index)?.feedback.as_ref()?.srv(),
+            })),
+            ChainBinding::Pass { index: earlier, .. } => {
+                views.push(Some(targets.get(*earlier)?.target.as_ref()?.srv()))
+            }
+            ChainBinding::Asset { id, .. } => views.push(Some(textures.get(id)?.srv[0].clone()?)),
+        }
+    }
+    Some(views)
+}
+
+impl DirectXRenderer {
+    /// Whether this device can run user shaders at all. `Window` asks before
+    /// it registers anything, so a 10.1 fallback reports `"unsupported"` up
+    /// front instead of failing shader by shader.
+    pub(crate) fn user_shaders_supported(&self) -> bool {
+        self.shaders.supported
+    }
+
+    /// Compiles the in-scene primitive variant of a program. `decorated` is
+    /// the composed module with explicit bind points; the bare variant blade
+    /// takes is no use here. Registering an id twice is a no-op.
+    pub(crate) fn register_user_shader(&mut self, id: u32, decorated: &str) {
+        if !self.shaders.supported || self.shaders.primitives.contains_key(&id) {
+            return;
+        }
+        let bytecode = match ShaderBytecode::build(decorated, &shader_translate::PRIMITIVE_BINDINGS)
+        {
+            Ok(bytecode) => bytecode,
+            Err(err) => {
+                log::error!("Failed to build the in-scene shader primitive: {err}");
+                return;
+            }
+        };
+        let Ok((vertex, fragment)) = bytecode.stages(&self.devices.device).log_err_owned() else {
+            return;
+        };
+        self.shaders.primitives.insert(
+            id,
+            PrimitiveProgram {
+                vertex,
+                fragment,
+                bytecode,
+                clock: ShaderClock::default(),
+            },
+        );
+    }
+
+    /// Compiles the region variant of a program - the chain that reads the
+    /// composed image under its bounds. Second call for an id is a no-op.
+    pub(crate) fn register_screen_shader(&mut self, id: u32, chain: &[ChainPassDesc]) {
+        if !self.shaders.supported || self.shaders.chains.contains_key(&id) {
+            return;
+        }
+        let Some(chain) = self.create_shader_chain(chain) else {
+            return;
+        };
+        self.shaders.chains.insert(id, chain);
+    }
+
+    /// Uploads a caller-provided image a chain can bind by name. Immutable and
+    /// uploaded in one go, since the bytes arrive with the registration.
+    pub(crate) fn register_user_texture(&mut self, id: u32, width: u32, height: u32, rgba8: &[u8]) {
+        if !self.shaders.supported || self.shaders.textures.contains_key(&id) {
+            return;
+        }
+        if let Some(texture) = create_user_texture(&self.devices.device, width, height, rgba8) {
+            self.shaders.textures.insert(id, texture);
+        }
+    }
+
+    /// Installs or clears the whole-window post-process program.
+    pub(crate) fn set_post_shader(&mut self, chain: Option<&[ChainPassDesc]>) {
+        self.shaders.post_targets.clear();
+        self.shaders.post_prev = None;
+        self.shaders.post_prev_index = 0;
+        let Some(chain) = chain else {
+            self.shaders.post = None;
+            return;
+        };
+        if !self.shaders.supported {
+            return;
+        }
+        self.shaders.post = self.create_shader_chain(chain).map(|chain| PostProgram {
+            chain,
+            clock: ShaderClock::default(),
+        });
+    }
+
+    pub(crate) fn set_post_signals(&mut self, signals: [f32; 16], meta: [f32; 8], mouse: [f32; 4]) {
+        self.shaders.post_signals = signals;
+        self.shaders.post_meta = meta;
+        self.shaders.post_mouse = mouse;
+        if let Some(post) = &mut self.shaders.post {
+            post.clock.tick();
+        }
+    }
+
+    /// Moves the post pass's mouse without advancing its clock: what an idle
+    /// repaint feeds, so a paused shader can follow the cursor while its
+    /// animation stays parked.
+    pub(crate) fn set_post_mouse(&mut self, mouse: [f32; 4]) {
+        self.shaders.post_mouse = mouse;
+    }
+
+    fn create_shader_chain(&self, chain: &[ChainPassDesc]) -> Option<ShaderChain> {
+        let mut passes = Vec::with_capacity(chain.len());
+        for pass in chain {
+            let bindings = pass
+                .bindings
+                .iter()
+                .map(HlslBinding::for_chain)
+                .collect::<Vec<_>>();
+            let bytecode = match ShaderBytecode::build(&pass.decorated, &bindings) {
+                Ok(bytecode) => bytecode,
+                Err(err) => {
+                    log::error!("Failed to build a screen shader pass: {err}");
+                    return None;
+                }
+            };
+            let (vertex, fragment) = bytecode.stages(&self.devices.device).log_err_owned().ok()?;
+            passes.push(ChainPass {
+                vertex,
+                fragment,
+                bytecode,
+                scale: pass.scale,
+                bindings: pass.bindings.clone(),
+            });
+        }
+        Some(ShaderChain { passes })
+    }
+
+    /// The offscreen the main pass composes into whenever anything shader-y is
+    /// live. Recycled across frames; the resize path is what throws it away.
+    fn ensure_scene_target(&mut self) -> Result<[Option<ID3D11RenderTargetView>; 1]> {
+        let (width, height) = (self.resources.width, self.resources.height);
+        let stale = self
+            .shaders
+            .scene
+            .as_ref()
+            .is_none_or(|scene| scene.width != width || scene.height != height);
+        if stale {
+            // Dropped first, so a failure leaves nothing behind rather than a
+            // target at the old size for the frame to compose into.
+            self.shaders.scene = None;
+            self.shaders.scene = Some(RenderTexture::new(&self.devices.device, width, height)?);
+        }
+        Ok(self.shaders.scene.as_ref().unwrap().rtv.clone())
+    }
+
+    /// Builds a chain's per-pass targets over a `width` by `height` surface.
+    /// The final pass draws into whatever the program was aimed at, so it gets
+    /// no target of its own; the rest get one at their scale. A pass that
+    /// reads `prev` gets a feedback buffer too, except the final post pass,
+    /// which ping-pongs its own pair instead, hence `feedback_for_final`.
+    fn create_chain_targets(
+        &self,
+        shape: &[(f32, bool)],
+        width: u32,
+        height: u32,
+        feedback_for_final: bool,
+    ) -> Option<Vec<ChainPassTarget>> {
+        let device = &self.devices.device;
+        let context = &self.devices.device_context;
+        let last = shape.len().saturating_sub(1);
+        let mut targets = Vec::with_capacity(shape.len());
+        for (index, (scale, uses_prev)) in shape.iter().enumerate() {
+            let is_last = index == last;
+            let pass_width = scaled_size(width, *scale);
+            let pass_height = scaled_size(height, *scale);
+            let make =
+                || RenderTexture::cleared(device, context, pass_width, pass_height).log_err();
+            let target = if is_last { None } else { Some(make()?) };
+            let feedback = if *uses_prev && (!is_last || feedback_for_final) {
+                Some(make()?)
+            } else {
+                None
+            };
+            targets.push(ChainPassTarget { target, feedback });
+        }
+        Some(targets)
+    }
+
+    /// Draws one chain pass: binds the uniform block, the sampler and the
+    /// pass's textures in the order its registers were assigned, then puts a
+    /// fullscreen triangle through it.
+    #[allow(clippy::too_many_arguments)]
+    fn draw_chain_pass(
+        &self,
+        pass: &ChainPass,
+        params: UserShaderParams,
+        target: &ID3D11RenderTargetView,
+        views: &[Option<ID3D11ShaderResourceView>],
+        viewport: &[D3D11_VIEWPORT; 1],
+        scissor: Option<RECT>,
+        clear: bool,
+    ) -> Result<()> {
+        let context = &self.devices.device_context;
+        update_buffer(
+            context,
+            self.shaders.params_buffer[0].as_ref().unwrap(),
+            &[params],
+        )?;
+        unsafe {
+            if clear {
+                context.ClearRenderTargetView(target, &[0.0; 4]);
+            }
+            context.OMSetRenderTargets(Some(&[Some(target.clone())]), None);
+            context.OMSetBlendState(&self.shaders.blend, None, 0xFFFFFFFF);
+            context.RSSetViewports(Some(viewport));
+            match scissor {
+                Some(rect) => {
+                    context.RSSetState(&self.shaders.scissor_rasterizer);
+                    context.RSSetScissorRects(Some(&[rect]));
+                }
+                None => context.RSSetState(&self.shaders.plain_rasterizer),
+            }
+            context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            context.VSSetShader(&pass.vertex, None);
+            context.PSSetShader(&pass.fragment, None);
+            context.PSSetConstantBuffers(0, Some(&self.shaders.params_buffer));
+            context.PSSetSamplers(0, Some(&self.shaders.sampler));
+            if !views.is_empty() {
+                context.PSSetShaderResources(0, Some(views));
+            }
+            // A fullscreen triangle needs no vertex buffer and no input
+            // layout; the vertex stage builds it from SV_VertexID.
+            context.Draw(3, 0);
+            context.RSSetState(&self.shaders.plain_rasterizer);
+        }
+        release_shader_resources(context, views.len());
+        Ok(())
+    }
+
+    /// Straight copy of `source` onto `target`. Needed because the swapchain
+    /// texture isn't a copy destination, so "region entries but no post
+    /// shader" still has to get the composed image across as a draw.
+    fn blit(&mut self, target: &ID3D11RenderTargetView, source: &ID3D11ShaderResourceView) {
+        if self.shaders.blit.is_none() {
+            let build = || -> std::result::Result<_, String> {
+                let vertex = shader_translate::compile(
+                    BLIT_HLSL,
+                    "blit_vertex",
+                    shader_translate::VERTEX_PROFILE,
+                )?;
+                let fragment = shader_translate::compile(
+                    BLIT_HLSL,
+                    "blit_fragment",
+                    shader_translate::FRAGMENT_PROFILE,
+                )?;
+                Ok((
+                    shader_translate::blob_bytes(&vertex),
+                    shader_translate::blob_bytes(&fragment),
+                ))
+            };
+            let stages = match build() {
+                Ok((vertex, fragment)) => ShaderBytecode { vertex, fragment }
+                    .stages(&self.devices.device)
+                    .log_err_owned()
+                    .ok(),
+                Err(err) => {
+                    log::error!("Failed to build the shader blit pipeline: {err}");
+                    None
+                }
+            };
+            let Some(stages) = stages else { return };
+            self.shaders.blit = Some(stages);
+        }
+        let Some((vertex, fragment)) = &self.shaders.blit else {
+            return;
+        };
+        let context = &self.devices.device_context;
+        unsafe {
+            context.ClearRenderTargetView(target, &[0.0; 4]);
+            context.OMSetRenderTargets(Some(&[Some(target.clone())]), None);
+            context.OMSetBlendState(&self.shaders.replace_blend, None, 0xFFFFFFFF);
+            context.RSSetState(&self.shaders.plain_rasterizer);
+            context.RSSetViewports(Some(&self.resources.viewport));
+            context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+            context.VSSetShader(vertex, None);
+            context.PSSetShader(fragment, None);
+            context.PSSetSamplers(0, Some(&self.shaders.sampler));
+            context.PSSetShaderResources(0, Some(&[Some(source.clone())]));
+            context.Draw(3, 0);
+        }
+        release_shader_resources(context, 1);
+    }
+
+    /// Puts the composed scene on the swapchain when region entries ran
+    /// without a post shader to carry it across.
+    fn blit_scene_to_swapchain(&mut self) {
+        let Some(scene) = self.shaders.scene.as_ref().map(RenderTexture::srv) else {
+            return;
+        };
+        let Some(target) = self.resources.render_target_view[0].clone() else {
+            return;
+        };
+        self.blit(&target, &scene);
+    }
+
+    /// The in-scene primitive batch: one instanced quad per entry, grouped
+    /// into runs that share a uniform block the way the blade path groups
+    /// them.
+    fn draw_user_shaders(&mut self, user_shaders: &[UserShader]) -> Result<()> {
+        let Some(first) = user_shaders.first() else {
+            return Ok(());
+        };
+        // The clock ticks on this shader's own draws, so a panel that stops
+        // painting freezes rather than jumping ahead.
+        let Some(program) = self.shaders.primitives.get_mut(&first.shader_id) else {
+            return Ok(());
+        };
+        program.clock.tick();
+        let (time, delta) = (program.clock.time, program.clock.delta);
+        let vertex = program.vertex.clone();
+        let fragment = program.fragment.clone();
+
+        // `params` is one uniform for the whole draw, and `mouse` is
+        // bounds-local, so instances only ride together while their feed and
+        // their whole bounds match.
+        let mut start = 0;
+        while start < user_shaders.len() {
+            let head = &user_shaders[start];
+            let mut end = start + 1;
+            while end < user_shaders.len()
+                && user_shaders[end].params == head.params
+                && user_shaders[end].meta == head.meta
+                && user_shaders[end].bounds == head.bounds
+            {
+                end += 1;
+            }
+            let run = &user_shaders[start..end];
+            let params = UserShaderParams {
+                time,
+                delta,
+                resolution: [head.bounds.size.width.0, head.bounds.size.height.0],
+                mouse: head.mouse,
+                meta: meta_rows(head.meta),
+                signals: signal_rows(head.params),
+            };
+            self.upload_shader_instances(run)?;
+            let Some(instances) = &self.shaders.instances else {
+                return Ok(());
+            };
+            let instance_view = instances.view.clone();
+            let context = &self.devices.device_context;
+            update_buffer(
+                context,
+                self.shaders.params_buffer[0].as_ref().unwrap(),
+                &[params],
+            )?;
+            unsafe {
+                context.OMSetBlendState(&self.shaders.blend, None, 0xFFFFFFFF);
+                context.RSSetState(&self.shaders.plain_rasterizer);
+                context.RSSetViewports(Some(&self.resources.viewport));
+                context.IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+                context.VSSetShader(&vertex, None);
+                context.PSSetShader(&fragment, None);
+                // b0 is the template's own globals block, b1 the shared
+                // uniform block; the instances are an SRV at t0.
+                let constants = [
+                    self.shaders.globals_buffer[0].clone(),
+                    self.shaders.params_buffer[0].clone(),
+                ];
+                context.VSSetConstantBuffers(0, Some(&constants));
+                context.PSSetConstantBuffers(0, Some(&constants));
+                context.VSSetShaderResources(0, Some(&instance_view));
+                context.PSSetShaderResources(0, Some(&instance_view));
+                context.DrawInstanced(4, run.len() as u32, 0, 0);
+            }
+            start = end;
+        }
+        Ok(())
+    }
+
+    /// Grows the raw instance buffer if it has to, then writes this run into
+    /// it. The primitive's WGSL declares a storage binding, so HLSL sees a
+    /// `ByteAddressBuffer` and the view has to be a raw one.
+    fn upload_shader_instances(&mut self, run: &[UserShader]) -> Result<()> {
+        let bytes = std::mem::size_of_val(run);
+        let grow = self
+            .shaders
+            .instances
+            .as_ref()
+            .is_none_or(|instances| instances.capacity < bytes);
+        if grow {
+            self.shaders.instances = Some(RawBuffer::new(&self.devices.device, bytes)?);
+        }
+        let instances = self.shaders.instances.as_ref().unwrap();
+        update_buffer(&self.devices.device_context, &instances.buffer, run)
+    }
+
+    /// Runs every region entry in paint order, so a later one reads what the
+    /// earlier ones left behind, then puts the main target back for whatever
+    /// draws next.
+    fn draw_shader_regions(&mut self, scene: &Scene) {
+        for region in scene.user_shader_regions() {
+            self.draw_shader_region(region);
+        }
+        unsafe {
+            self.devices
+                .device_context
+                .OMSetRenderTargets(Some(&self.main_target_view), None);
+            self.devices
+                .device_context
+                .RSSetViewports(Some(&self.resources.viewport));
+        }
+    }
+
+    /// Re-runs one registered program over everything already composed under
+    /// `region.bounds`, writing back into the same scene target.
+    fn draw_shader_region(&mut self, region: &UserShaderRegion) {
+        if !self.shaders.chains.contains_key(&region.shader_id) || self.shaders.scene.is_none() {
+            return;
+        }
+
+        let surface_width = self.resources.width as i32;
+        let surface_height = self.resources.height as i32;
+        let left = region.bounds.origin.x.0.round() as i32;
+        let top = region.bounds.origin.y.0.round() as i32;
+        let width = region.bounds.size.width.0.round().max(0.0) as u32;
+        let height = region.bounds.size.height.0.round().max(0.0) as u32;
+        if width == 0 || height == 0 {
+            return;
+        }
+
+        // The copy takes whatever part of the bounds is actually on screen;
+        // the shader still sees uv 0..1 across the whole bounds, so a panel
+        // hanging off the edge reads transparent black out there rather than
+        // a stretched image.
+        let copy_left = left.max(0);
+        let copy_top = top.max(0);
+        let copy_right = (left + width as i32).min(surface_width);
+        let copy_bottom = (top + height as i32).min(surface_height);
+        if copy_right <= copy_left || copy_bottom <= copy_top {
+            return;
+        }
+
+        // Everything outside the content mask belongs to whoever drew it, so
+        // the scissor is what keeps this pass inside its own lane.
+        let mask = region.content_mask.bounds;
+        let clip_left = left.max(mask.origin.x.0.round() as i32).max(0);
+        let clip_top = top.max(mask.origin.y.0.round() as i32).max(0);
+        let clip_right = (left + width as i32)
+            .min((mask.origin.x.0 + mask.size.width.0).round() as i32)
+            .min(surface_width);
+        let clip_bottom = (top + height as i32)
+            .min((mask.origin.y.0 + mask.size.height.0).round() as i32)
+            .min(surface_height);
+        if clip_right <= clip_left || clip_bottom <= clip_top {
+            return;
+        }
+
+        self.ensure_region_instance(region, width, height);
+        let Some(instance) = self.shaders.regions.get_mut(&region.instance) else {
+            return;
+        };
+        instance.clock.tick();
+        let (time, delta) = (instance.clock.time, instance.clock.delta);
+        let scratch_view = instance.scratch.srv();
+        let scratch_texture = instance.scratch.texture.clone();
+
+        let source_box = D3D11_BOX {
+            left: copy_left as u32,
+            top: copy_top as u32,
+            front: 0,
+            right: copy_right as u32,
+            bottom: copy_bottom as u32,
+            back: 1,
+        };
+        let local_origin = ((copy_left - left) as u32, (copy_top - top) as u32);
+        let scene_texture = self.shaders.scene.as_ref().unwrap().texture.clone();
+        let scene_rtv = self.shaders.scene.as_ref().unwrap().rtv().clone();
+
+        // One snapshot of the composed image per frame: every pass that reads
+        // `screen` reads this same scratch.
+        unsafe {
+            self.devices.device_context.CopySubresourceRegion(
+                &scratch_texture,
+                0,
+                local_origin.0,
+                local_origin.1,
+                0,
+                &scene_texture,
+                0,
+                Some(&source_box),
+            );
+        }
+
+        let Some(last) = self.shaders.chains[&region.shader_id]
+            .passes
+            .len()
+            .checked_sub(1)
+        else {
+            return;
+        };
+        for index in 0..=last {
+            let is_last = index == last;
+            let instance = &self.shaders.regions[&region.instance];
+            let pass = &self.shaders.chains[&region.shader_id].passes[index];
+            let (target_view, resolution, viewport, scissor) = if is_last {
+                (
+                    scene_rtv.clone(),
+                    [width as f32, height as f32],
+                    [D3D11_VIEWPORT {
+                        TopLeftX: left as f32,
+                        TopLeftY: top as f32,
+                        Width: width as f32,
+                        Height: height as f32,
+                        MinDepth: 0.0,
+                        MaxDepth: 1.0,
+                    }],
+                    Some(RECT {
+                        left: clip_left,
+                        top: clip_top,
+                        right: clip_right,
+                        bottom: clip_bottom,
+                    }),
+                )
+            } else {
+                let Some(target) = instance.targets.get(index).and_then(|t| t.target.as_ref())
+                else {
+                    return;
+                };
+                (
+                    target.rtv().clone(),
+                    [target.width as f32, target.height as f32],
+                    full_viewport(target.width, target.height),
+                    None,
+                )
+            };
+            let Some(views) = chain_pass_resources(
+                &pass.bindings,
+                Some(&scratch_view),
+                None,
+                &instance.targets,
+                index,
+                &self.shaders.textures,
+            ) else {
+                return;
+            };
+            let params = UserShaderParams {
+                time,
+                delta,
+                resolution,
+                mouse: region.mouse,
+                meta: meta_rows(region.meta),
+                signals: signal_rows(region.signals),
+            };
+            // Intermediates draw onto their own cleared texture, where the
+            // premultiplied blend is the identity. The final pass lands on the
+            // loaded frame, so a transparent program composites over the panel
+            // it rides and an opaque one replaces its rect.
+            if self
+                .draw_chain_pass(
+                    pass,
+                    params,
+                    &target_view,
+                    &views,
+                    &viewport,
+                    scissor,
+                    !is_last,
+                )
+                .log_err()
+                .is_none()
+            {
+                return;
+            }
+
+            // Feedback is last frame's output, so the copy happens after the
+            // pass that produced this frame's. The final pass reads its rect
+            // back out of the scene target it just drew into.
+            self.copy_region_feedback(region.instance, index, is_last, &source_box, local_origin);
+        }
+    }
+
+    fn copy_region_feedback(
+        &self,
+        instance_key: u64,
+        index: usize,
+        is_last: bool,
+        source_box: &D3D11_BOX,
+        local_origin: (u32, u32),
+    ) {
+        let Some(instance) = self.shaders.regions.get(&instance_key) else {
+            return;
+        };
+        let Some(target) = instance.targets.get(index) else {
+            return;
+        };
+        let Some(feedback) = target.feedback.as_ref() else {
+            return;
+        };
+        unsafe {
+            if is_last {
+                let Some(scene) = self.shaders.scene.as_ref() else {
+                    return;
+                };
+                self.devices.device_context.CopySubresourceRegion(
+                    &feedback.texture,
+                    0,
+                    local_origin.0,
+                    local_origin.1,
+                    0,
+                    &scene.texture,
+                    0,
+                    Some(source_box),
+                );
+            } else if let Some(pass_target) = target.target.as_ref() {
+                self.devices.device_context.CopySubresourceRegion(
+                    &feedback.texture,
+                    0,
+                    0,
+                    0,
+                    0,
+                    &pass_target.texture,
+                    0,
+                    None,
+                );
+            }
+        }
+    }
+
+    /// Makes sure this instance has a scratch texture and the chain's pass
+    /// targets at the region's current size. A size change, a different
+    /// program or a newly needed feedback buffer all rebuild from scratch,
+    /// cleared: trails restart rather than smearing the old size.
+    fn ensure_region_instance(&mut self, region: &UserShaderRegion, width: u32, height: u32) {
+        let Some(chain) = self.shaders.chains.get(&region.shader_id) else {
+            return;
+        };
+        let shape = chain.target_shape();
+        let stale = match self.shaders.regions.get(&region.instance) {
+            Some(instance) => {
+                instance.width != width
+                    || instance.height != height
+                    || instance.shader_id != region.shader_id
+                    || (region.uses_prev
+                        && !instance
+                            .targets
+                            .iter()
+                            .any(|target| target.feedback.is_some()))
+            }
+            None => true,
+        };
+        if !stale {
+            return;
+        }
+        self.shaders.regions.remove(&region.instance);
+
+        let Some(scratch) = RenderTexture::cleared(
+            &self.devices.device,
+            &self.devices.device_context,
+            width,
+            height,
+        )
+        .log_err() else {
+            return;
+        };
+        let Some(targets) = self.create_chain_targets(&shape, width, height, true) else {
+            return;
+        };
+        self.shaders.regions.insert(
+            region.instance,
+            RegionInstance {
+                shader_id: region.shader_id,
+                width,
+                height,
+                scratch,
+                targets,
+                clock: ShaderClock::default(),
+            },
+        );
+    }
+
+    /// The whole-window pass. Without feedback the final pass writes straight
+    /// to the swapchain; with it, it ping-pongs two intermediates so `prev` is
+    /// last frame's finished image, and blits the winner across.
+    fn draw_post_pass(&mut self) {
+        let Some(post) = &self.shaders.post else {
+            return;
+        };
+        let (time, delta) = (post.clock.time, post.clock.delta);
+        let shape = post.chain.target_shape();
+        let Some(last) = shape.len().checked_sub(1) else {
+            return;
+        };
+        let uses_prev = shape[last].1;
+        // A chain that never reads the composed frame can't put it back, so
+        // its output alone would erase the app it was meant to ride. Those get
+        // the frame blitted under them and land on it loaded, where the
+        // premultiplied blend composites the shader over it.
+        let overlay = !uses_prev && !post.chain.passes.iter().any(ChainPass::samples_screen);
+
+        let (width, height) = (self.resources.width, self.resources.height);
+        if self.shaders.post_targets.len() != shape.len() {
+            let Some(targets) = self.create_chain_targets(&shape, width, height, false) else {
+                return;
+            };
+            self.shaders.post_targets = targets;
+        }
+        if uses_prev && self.shaders.post_prev.is_none() {
+            let make = || {
+                RenderTexture::cleared(
+                    &self.devices.device,
+                    &self.devices.device_context,
+                    width,
+                    height,
+                )
+                .log_err()
+            };
+            let (Some(first), Some(second)) = (make(), make()) else {
+                return;
+            };
+            self.shaders.post_prev = Some([first, second]);
+        }
+
+        let Some(scene_view) = self.shaders.scene.as_ref().map(RenderTexture::srv) else {
+            return;
+        };
+        let Some(swapchain) = self.resources.render_target_view[0].clone() else {
+            return;
+        };
+        let (final_view, prev_view) = match &self.shaders.post_prev {
+            Some(pair) => (
+                pair[self.shaders.post_prev_index].rtv().clone(),
+                Some(pair[1 - self.shaders.post_prev_index].srv()),
+            ),
+            None => (swapchain.clone(), None),
+        };
+        if overlay {
+            self.blit(&final_view, &scene_view);
+        }
+
+        for index in 0..=last {
+            let is_last = index == last;
+            let post = self.shaders.post.as_ref().unwrap();
+            let pass = &post.chain.passes[index];
+            let (target_view, resolution, viewport) = if is_last {
+                (
+                    final_view.clone(),
+                    [width as f32, height as f32],
+                    full_viewport(width, height),
+                )
+            } else {
+                let Some(target) = self
+                    .shaders
+                    .post_targets
+                    .get(index)
+                    .and_then(|t| t.target.as_ref())
+                else {
+                    return;
+                };
+                (
+                    target.rtv().clone(),
+                    [target.width as f32, target.height as f32],
+                    full_viewport(target.width, target.height),
+                )
+            };
+            // The final pass's `prev` is the ping-pong partner, not a copy:
+            // the finished frame is already sitting in the other half.
+            let final_prev = if is_last { prev_view.as_ref() } else { None };
+            let Some(views) = chain_pass_resources(
+                &pass.bindings,
+                Some(&scene_view),
+                final_prev,
+                &self.shaders.post_targets,
+                index,
+                &self.shaders.textures,
+            ) else {
+                return;
+            };
+            let params = UserShaderParams {
+                time,
+                delta,
+                resolution,
+                mouse: self.shaders.post_mouse,
+                meta: meta_rows(self.shaders.post_meta),
+                signals: signal_rows(self.shaders.post_signals),
+            };
+            if self
+                .draw_chain_pass(
+                    pass,
+                    params,
+                    &target_view,
+                    &views,
+                    &viewport,
+                    None,
+                    !(is_last && overlay),
+                )
+                .log_err()
+                .is_none()
+            {
+                return;
+            }
+
+            if !is_last {
+                let target = &self.shaders.post_targets[index];
+                if let (Some(pass_target), Some(feedback)) =
+                    (target.target.as_ref(), target.feedback.as_ref())
+                {
+                    unsafe {
+                        self.devices.device_context.CopySubresourceRegion(
+                            &feedback.texture,
+                            0,
+                            0,
+                            0,
+                            0,
+                            &pass_target.texture,
+                            0,
+                            None,
+                        );
+                    }
+                }
+            }
+        }
+
+        if self.shaders.post_prev.is_some() {
+            let finished =
+                self.shaders.post_prev.as_ref().unwrap()[self.shaders.post_prev_index].srv();
+            self.blit(&swapchain, &finished);
+            self.shaders.post_prev_index = 1 - self.shaders.post_prev_index;
+        }
+    }
+}
+
+/// The uniform block stores `meta` and `signals` as vec4 rows; the caller
+/// hands them over flat.
+fn meta_rows(meta: [f32; 8]) -> [[f32; 4]; 2] {
+    [
+        [meta[0], meta[1], meta[2], meta[3]],
+        [meta[4], meta[5], meta[6], meta[7]],
+    ]
+}
+
+fn signal_rows(signals: [f32; 16]) -> [[f32; 4]; 4] {
+    [
+        [signals[0], signals[1], signals[2], signals[3]],
+        [signals[4], signals[5], signals[6], signals[7]],
+        [signals[8], signals[9], signals[10], signals[11]],
+        [signals[12], signals[13], signals[14], signals[15]],
+    ]
+}
