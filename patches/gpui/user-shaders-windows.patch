@@ -0,0 +1,271 @@
+//! rox patch: WGSL to HLSL for the user shader pipeline.
+//!
+//! The blade backends hand their composed modules straight to blade, which
+//! speaks WGSL. The DirectX renderer doesn't, so the composed module gets
+//! translated here and compiled with FXC before it becomes a pipeline. The
+//! source is the `@group(0) @binding(n)`-decorated variant that
+//! `ChainPassDesc` carries alongside the bare one, so the register map falls
+//! straight out of the pinned binding order - no reflection round trip.
+
+use windows::{
+    Win32::Graphics::Direct3D::{
+        Fxc::{D3DCOMPILE_OPTIMIZATION_LEVEL3, D3DCompile},
+        ID3DBlob, ID3DInclude,
+    },
+    core::PCSTR,
+};
+
+use crate::window::ChainBinding;
+
+/// What one binding becomes on the D3D11 side. The chain bindings map onto
+/// this; the in-scene primitive declares its three by hand.
+#[derive(Copy, Clone, Debug, Eq, PartialEq)]
+pub(crate) enum HlslBinding {
+    /// A constant buffer, `b{n}`.
+    Uniform,
+    /// The sampler, `s{n}`.
+    Sampler,
+    /// A texture SRV, `t{n}`.
+    Texture,
+    /// A read-only storage buffer, which HLSL sees as a `ByteAddressBuffer`,
+    /// so it shares the SRV registers with textures.
+    Storage,
+}
+
+impl HlslBinding {
+    /// How a chain pass's bindings land on registers: the uniform block is the
+    /// one constant buffer, `samp` the one sampler, everything else a texture
+    /// in the order the pass pinned.
+    pub(crate) fn for_chain(binding: &ChainBinding) -> Self {
+        match binding {
+            ChainBinding::Params => HlslBinding::Uniform,
+            ChainBinding::Sampler => HlslBinding::Sampler,
+            _ => HlslBinding::Texture,
+        }
+    }
+}
+
+/// The bindings the in-scene primitive's template declares, in the order
+/// `compose_user_shader_source` decorates them.
+pub(crate) const PRIMITIVE_BINDINGS: [HlslBinding; 3] = [
+    HlslBinding::Uniform,
+    HlslBinding::Uniform,
+    HlslBinding::Storage,
+];
+
+/// A translated module plus the entry point names it actually ended up with.
+/// naga renames anything that collides with an HLSL keyword, so the compiler
+/// gets told what the writer emitted rather than what the WGSL said.
+pub(crate) struct TranslatedShader {
+    pub source: String,
+    pub vertex_entry: String,
+    pub fragment_entry: String,
+}
+
+/// Where a binding sits once the whole list has been walked.
+fn register_of(bindings: &[HlslBinding], index: usize) -> u32 {
+    let kind = bindings[index];
+    bindings[..index]
+        .iter()
+        .filter(|earlier| match kind {
+            // Textures and byte-address buffers are both SRVs, so they share a
+            // counter; the two others get one each.
+            HlslBinding::Texture | HlslBinding::Storage => {
+                matches!(earlier, HlslBinding::Texture | HlslBinding::Storage)
+            }
+            other => **earlier == other,
+        })
+        .count() as u32
+}
+
+/// The register map for a decorated module: `@binding(n)` indexes `bindings`,
+/// which is the same vec the renderer walks when it binds resources.
+fn binding_map(bindings: &[HlslBinding]) -> naga::back::hlsl::BindingMap {
+    let mut map = naga::back::hlsl::BindingMap::default();
+    for index in 0..bindings.len() {
+        map.insert(
+            naga::ResourceBinding {
+                group: 0,
+                binding: index as u32,
+            },
+            naga::back::hlsl::BindTarget {
+                space: 0,
+                register: register_of(bindings, index),
+                binding_array_size: None,
+                dynamic_storage_buffer_offsets_index: None,
+                // WGSL bounds-checks its indexing and the shaders here index
+                // `signals` and `user_meta` with runtime values, so keep the
+                // clamps naga would emit on any other backend.
+                restrict_indexing: true,
+            },
+        );
+    }
+    map
+}
+
+/// Translates one decorated WGSL module to HLSL. `bindings` is the pass's
+/// pinned binding order; `Err` carries naga's message the way registration
+/// hands back a validation error.
+pub(crate) fn translate(
+    source: &str,
+    bindings: &[HlslBinding],
+) -> Result<TranslatedShader, String> {
+    use naga::back::hlsl;
+
+    let module = naga::front::wgsl::parse_str(source).map_err(|err| err.emit_to_string(source))?;
+    let info = naga::valid::Validator::new(
+        naga::valid::ValidationFlags::all(),
+        naga::valid::Capabilities::default(),
+    )
+    .validate(&module)
+    .map_err(|err| err.emit_to_string(source))?;
+
+    let options = hlsl::Options {
+        // FXC tops out here, and the pipeline refuses to register on a device
+        // that can't reach it.
+        shader_model: hlsl::ShaderModel::V5_0,
+        binding_map: binding_map(bindings),
+        // Every binding is spelled out above, so a module that reaches for one
+        // that isn't should fail loudly rather than get a made-up register.
+        fake_missing_bindings: false,
+        // The sampler index buffer never survives the rewrite below, but the
+        // writer still refuses to emit one without a target.
+        sampler_buffer_binding_map: [(
+            hlsl::SamplerIndexBufferKey { group: 0 },
+            hlsl::BindTarget::default(),
+        )]
+        .into_iter()
+        .collect(),
+        ..Default::default()
+    };
+
+    let mut hlsl_source = String::new();
+    let reflection = hlsl::Writer::new(&mut hlsl_source, &options)
+        .write(&module, &info, None)
+        .map_err(|err| format!("HLSL translation failed: {err}"))?;
+
+    let entry_name = |stage: naga::ShaderStage| -> Result<String, String> {
+        let index = module
+            .entry_points
+            .iter()
+            .position(|entry| entry.stage == stage)
+            .ok_or_else(|| format!("the composed module has no {stage:?} entry point"))?;
+        match reflection.entry_point_names.get(index) {
+            Some(Ok(name)) => Ok(name.clone()),
+            Some(Err(err)) => Err(format!("HLSL translation failed: {err}")),
+            None => Err("HLSL translation dropped an entry point".to_string()),
+        }
+    };
+
+    Ok(TranslatedShader {
+        vertex_entry: entry_name(naga::ShaderStage::Vertex)?,
+        fragment_entry: entry_name(naga::ShaderStage::Fragment)?,
+        source: rewrite_sampler(&hlsl_source),
+    })
+}
+
+/// naga routes every sampler through D3D12's bindless construct: an unbounded
+/// `SamplerState` heap in a non-zero register space, indexed through a
+/// structured buffer. D3D11 has neither register spaces nor unbounded sampler
+/// arrays, so the three declarations get dropped and the `static const` alias
+/// becomes a plain `s0` sampler.
+///
+/// This is a rewrite of generated code, so it's the thing here most likely to
+/// break quietly on a naga bump. The guard is the compile-level test in
+/// `window.rs`, which asserts FXC accepts the result rather than comparing
+/// text.
+fn rewrite_sampler(hlsl: &str) -> String {
+    const HEAP: &str = "SamplerState nagaSamplerHeap[";
+    const COMPARISON_HEAP: &str = "SamplerComparisonState nagaComparisonSamplerHeap[";
+    const INDEX_BUFFER: &str = "StructuredBuffer<uint> naga";
+    const ALIAS: &str = "static const SamplerState ";
+
+    let mut out = String::with_capacity(hlsl.len());
+    for line in hlsl.lines() {
+        let trimmed = line.trim_start();
+        if trimmed.starts_with(HEAP)
+            || trimmed.starts_with(COMPARISON_HEAP)
+            || (trimmed.starts_with(INDEX_BUFFER) && trimmed.contains("SamplerIndexArray"))
+        {
+            continue;
+        }
+        if let Some(rest) = trimmed.strip_prefix(ALIAS)
+            && let Some((name, _)) = rest.split_once(" = ")
+        {
+            out.push_str(&format!("SamplerState {name} : register(s0);\n"));
+            continue;
+        }
+        out.push_str(line);
+        out.push('\n');
+    }
+    out
+}
+
+/// FXC over a translated module. The error blob comes back verbatim, matching
+/// how the blade path hands naga's message to the caller.
+pub(crate) fn compile(source: &str, entry_point: &str, target: &str) -> Result<ID3DBlob, String> {
+    let entry = format!("{entry_point}\0");
+    let target = format!("{target}\0");
+    let mut code = None;
+    let mut errors = None;
+
+    let result = unsafe {
+        D3DCompile(
+            source.as_ptr() as *const _,
+            source.len(),
+            PCSTR::null(),
+            None,
+            None::<&ID3DInclude>,
+            PCSTR::from_raw(entry.as_ptr()),
+            PCSTR::from_raw(target.as_ptr()),
+            D3DCOMPILE_OPTIMIZATION_LEVEL3,
+            0,
+            &mut code,
+            Some(&mut errors),
+        )
+    };
+
+    match result {
+        Ok(()) => code.ok_or_else(|| "the shader compiler returned no bytecode".to_string()),
+        Err(err) => Err(compile_error(errors, err)),
+    }
+}
+
+fn compile_error(errors: Option<ID3DBlob>, fallback: windows::core::Error) -> String {
+    let Some(errors) = errors else {
+        return format!("{fallback}");
+    };
+    let text = unsafe {
+        std::ffi::CStr::from_ptr(errors.GetBufferPointer() as *const i8).to_string_lossy()
+    };
+    let text = text.trim();
+    if text.is_empty() {
+        format!("{fallback}")
+    } else {
+        text.to_string()
+    }
+}
+
+/// The bytecode of a compiled stage, kept so a lost device can rebuild its
+/// pipelines without the caller re-registering anything.
+pub(crate) fn blob_bytes(blob: &ID3DBlob) -> Vec<u8> {
+    unsafe {
+        std::slice::from_raw_parts(blob.GetBufferPointer() as *const u8, blob.GetBufferSize())
+            .to_vec()
+    }
+}
+
+/// Translates and compiles both stages of one composed module.
+pub(crate) fn build(source: &str, bindings: &[HlslBinding]) -> Result<(Vec<u8>, Vec<u8>), String> {
+    let translated = translate(source, bindings)?;
+    let vertex = compile(&translated.source, &translated.vertex_entry, VERTEX_PROFILE)?;
+    let fragment = compile(
+        &translated.source,
+        &translated.fragment_entry,
+        FRAGMENT_PROFILE,
+    )?;
+    Ok((blob_bytes(&vertex), blob_bytes(&fragment)))
+}
+
+pub(crate) const VERTEX_PROFILE: &str = "vs_5_0";
+pub(crate) const FRAGMENT_PROFILE: &str = "ps_5_0";
