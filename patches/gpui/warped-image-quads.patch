+/// The homography carrying the rectangle at `origin`/`size` (scaled px)
+/// onto `quad`, its target corners clockwise from the top-left, split the
+/// way [`PolychromeSprite`] wants it: the affine rows as a
+/// [`TransformationMatrix`] and the perspective row normalized so
+/// w = 1 + perspective . p. None when the quad is degenerate.
+///
+/// rox patch: the CPU half of `paint_image_quad`, Heckbert's unit-square
+/// projective mapping composed with the rect-to-unit affine.
+fn quad_homography(
+    origin: [f32; 2],
+    size: [f32; 2],
+    quad: [[f32; 2]; 4],
+) -> Option<(TransformationMatrix, [f32; 4])> {
+    let [tl, tr, br, bl] = quad;
+    let [ox, oy] = origin;
+    let [width, height] = size;
+    if width <= 0.0 || height <= 0.0 {
+        return None;
+    }
+    // Unit square onto the quad (Heckbert): the affine terms fall out of
+    // the perspective row, which is zero when the opposite edge sums
+    // cancel - a parallelogram.
+    let sx = tl[0] - tr[0] + br[0] - bl[0];
+    let sy = tl[1] - tr[1] + br[1] - bl[1];
+    let (g, h) = if sx == 0.0 && sy == 0.0 {
+        (0.0, 0.0)
+    } else {
+        let dx1 = tr[0] - br[0];
+        let dx2 = bl[0] - br[0];
+        let dy1 = tr[1] - br[1];
+        let dy2 = bl[1] - br[1];
+        let den = dx1 * dy2 - dx2 * dy1;
+        if den.abs() < f32::EPSILON {
+            return None;
+        }
+        ((sx * dy2 - dx2 * sy) / den, (dx1 * sy - sx * dy1) / den)
+    };
+    let a = tr[0] - tl[0] + g * tr[0];
+    let b = bl[0] - tl[0] + h * bl[0];
+    let c = tl[0];
+    let d = tr[1] - tl[1] + g * tr[1];
+    let e = bl[1] - tl[1] + h * bl[1];
+    let f = tl[1];
+    // Composed with u = (p - origin) / size, then the whole map scaled so
+    // w is one at the rect's center. A homography is only defined up to
+    // scale, and the GPU clips w < 0 as behind the eye; the center is the
+    // one point guaranteed on the visible side of the vanishing line, so
+    // normalizing there keeps w positive across the whole quad. (The
+    // screen origin is not so guaranteed: a keystone's vanishing line can
+    // cross between origin and quad, which flipped the map's sign and
+    // swallowed every right-leaning cover.)
+    let px = [g / width, h / height];
+    let w0 = 1.0 - g * ox / width - h * oy / height;
+    let center = [ox + width / 2.0, oy + height / 2.0];
+    let k = w0 + px[0] * center[0] + px[1] * center[1];
+    if k.abs() < 1e-6 {
+        return None;
+    }
+    let row0 = [a / width / k, b / height / k];
+    let row1 = [d / width / k, e / height / k];
+    let translation = [
+        (c - a * ox / width - b * oy / height) / k,
+        (f - d * ox / width - e * oy / height) / k,
+    ];
+    let perspective = [px[0] / k, px[1] / k, w0 / k, 0.0];
+    // A quad leaning past its own horizon has no one-sided w; skip it
+    // rather than let the GPU clip half a face. w lives on the vertex
+    // domain, so the corners to check are the rect's.
+    for [x, y] in [
+        [ox, oy],
+        [ox + width, oy],
+        [ox + width, oy + height],
+        [ox, oy + height],
+    ] {
+        if perspective[2] + perspective[0] * x + perspective[1] * y <= 0.0 {
+            return None;
+        }
+    }
+    Some((
+        TransformationMatrix {
+            rotation_scale: [row0, row1],
+            translation,
+        },
+        perspective,
+    ))
+}
