+    /// rox patch: opens a mask span for `instance`, the id a screen-shader
+    /// region carries. Everything painted until the matching `end_mask_span`
+    /// is what a shader binding `mask` sees as content coverage. The span
+    /// rides `paint_operations` as marker entries rather than an index pair
+    /// held elsewhere, so a cached subtree replayed out of the previous
+    /// frame's operations carries its span with it.
+    pub(crate) fn begin_mask_span(&mut self, instance: u64) {
+        self.paint_operations
+            .push(PaintOperation::StartMaskSpan(instance));
+    }
+
+    pub(crate) fn end_mask_span(&mut self) {
+        self.paint_operations.push(PaintOperation::EndMaskSpan);
+    }
