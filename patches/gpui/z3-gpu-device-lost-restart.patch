+// rox patch: what to do about a GPU that's gone for good, installed by the
+// app. See wait_for_gpu for when it fires.
+static GPU_DEVICE_LOST_HANDLER: OnceLock<Box<dyn Fn() + Send + Sync>> = OnceLock::new();
+
+/// rox patch: install the response to a lost GPU device. wait_for_gpu calls
+/// it once it's given up on the frame fence, from whichever thread was
+/// drawing. Re-execing the process is the intended move; a handler that
+/// declines by returning (or no handler at all) falls back to exiting,
+/// because nothing can be drawn from here. First install wins.
+pub fn set_gpu_device_lost_handler(handler: impl Fn() + Send + Sync + 'static) {
+    let _ = GPU_DEVICE_LOST_HANDLER.set(Box::new(handler));
+}
