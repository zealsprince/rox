 const MAX_FRAME_TIME_MS: u32 = 10000;
 
+// rox patch: how long a stalled GPU gets to come back before we stop waiting
+// on it. Six of the timeouts above.
+const MAX_GPU_HANG_TIME: Duration = Duration::from_secs(60);
