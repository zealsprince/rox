+// rox patch: frames a CPU Vulkan driver presents to a 32-bit visual never
+// reach the screen, composited or not (lavapipe under Xvfb and xcompmgr, VMs
+// without 3D). On a real GPU an ARGB window still needs a compositing manager
+// to be see-through at all. EWMH names that selection after the screen
+// number, not the root window.
+fn argb_visual_usable(xcb: &XCBConnection, screen_index: usize, gpu: &BladeContext) -> bool {
+    if gpu.is_software_emulated() {
+        return false;
+    }
+
+    let name = format!("_NET_WM_CM_S{screen_index}");
+    let Some(atom) = xcb
+        .intern_atom(true, name.as_bytes())
+        .ok()
+        .and_then(|cookie| cookie.reply().ok())
+        .map(|reply| reply.atom)
+    else {
+        return false;
+    };
+    if atom == x11rb::NONE {
+        return false;
+    }
+
+    xcb.get_selection_owner(atom)
+        .ok()
+        .and_then(|cookie| cookie.reply().ok())
+        .is_some_and(|reply| reply.owner != x11rb::NONE)
+}
